remappingStrategy {
  activeKey.gpon = "${sv.activeWan.ancestorKey(3).toParameterKey}.X_FH_GponInterfaceConfig"
  lan = "${sv.activeLan.toParameterKey}"
  lanIpInterface = "${sv.activeLan.toParameterKey}.LANHostConfigManagement.IPInterface.1"
  wifiSecurity {
    // Expression check if all real key values are set to NONE
    isNone = """if(
      realValue('BeaconType') == 'None' and
      realValue('BasicEncryptionModes') == 'None' and
      realValue('BasicAuthenticationMode') == 'OpenSystem'
    ) 'NONE'"""

    // Expresion return proper value for relevant real key to set NONE
    setNone = """if(value == 'NONE')(
      map('BeaconType' -> 'None',
          'BasicEncryptionModes' -> 'None',
          'BasicAuthenticationMode' -> 'OpenSystem'
      ).get(key.keyName)
    )"""
    // Expression check if all real key values are set to WPA_WPA2
    isWpa_Wpa2 = """if(
      realValue('BeaconType') == 'WPAand11i' and
      realValue('WPAEncryptionModes') == 'TKIPandAESEncryption' and
      realValue('WPAAuthenticationMode') == 'PSKAuthentication' and
      realValue('IEEE11iEncryptionModes') == 'TKIPandAESEncryption' and
      realValue('IEEE11iAuthenticationMode') == 'PSKAuthentication'
    ) 'WPA_WPA2'"""

    // Expresion return proper value for relevant real key to set WPA_WPA2
    setWpa_Wpa2 = """if(value == 'WPA_WPA2')(
      map('BeaconType' -> 'WPAand11i',
          'WPAEncryptionModes' -> 'TKIPandAESEncryption',
          'WPAAuthenticationMode' -> 'PSKAuthentication',
          'IEEE11iEncryptionModes' -> 'TKIPandAESEncryption',
          'IEEE11iAuthenticationMode' -> 'PSKAuthentication'
      ).get(key.keyName)
    )"""
  }
  read_converter {
    WiFi.%i {
      Security = ${tools.expression} {
        expression = """${
            """${remappingStrategy.wifiSecurity.isNone}""" else
            """${remappingStrategy.wifiSecurity.isWpa_Wpa2}""" else 'CUSTOM' }"""
      }
      AssociatedDevice.%i {
        SignalStrength {
           expression = "${singleValue.toInt}"
           type = expression
        }
        SignalToNoiseRatio {
           expression = "${singleValue.toInt}"
           type = expression
        }
      }
    }
  }
  write_converter.WiFi.%i {
    Security = ${tools.expression} {
      expression = """${
          """${remappingStrategy.wifiSecurity.setNone}""" else
          """${remappingStrategy.wifiSecurity.setWpa_Wpa2}""" else null}"""
    }
  }


  mapping {
    root.X_AVS_EXT {
      WAN.PPP {
        Password.real = "${sv.activePpp.toParameterKey}.Password"
      }
      WiFiNeighborhood.%i {
        BSSID.real = "root.WiFi.NeighboringWiFiDiagnostic.Result.%i.BSSID"
        Channel.real = "root.WiFi.NeighboringWiFiDiagnostic.Result.%i.Channel"
        SSID.real = "root.WiFi.NeighboringWiFiDiagnostic.Result.%i.SSID"
        Security.real = "root.WiFi.NeighboringWiFiDiagnostic.Result.%i.SecurityModeEnabled"
        SignalStrength.real = "root.WiFi.NeighboringWiFiDiagnostic.Result.%i.SignalStrength"
        Standard.real = "root.WiFi.NeighboringWiFiDiagnostic.Result.%i.OperatingStandards"
        ChannelBandwidth.real = "root.WiFi.NeighboringWiFiDiagnostic.Result.%i.OperatingChannelBandwidth"
      }
      WiFi {
        1 {
          Enable.real = "root.LANDevice.1.WLANConfiguration.1.Enable"
          SSID.real = "root.LANDevice.1.WLANConfiguration.1.SSID"
          Password.real = "root.LANDevice.1.WLANConfiguration.1.PreSharedKey.1.KeyPassphrase"
          Channel.real = "root.LANDevice.1.WLANConfiguration.1.Channel"
          AutoChannelEnable.real = "root.LANDevice.1.WLANConfiguration.1.AutoChannelEnable"
          AssociatedDevice.%i {
            MACAddress.real = "root.LANDevice.1.WLANConfiguration.1.AssociatedDevice.%i.AssociatedDeviceMACAddress"
            AuthenticationState.real = "root.LANDevice.1.WLANConfiguration.1.AssociatedDevice.%i.AssociatedDeviceAuthenticationState"
            IPAddress.real = "root.LANDevice.1.WLANConfiguration.1.AssociatedDevice.%i.AssociatedDeviceIPAddress"
            SignalStrength.real = "root.LANDevice.1.WLANConfiguration.1.AssociatedDevice.%i.X_FH_RSSI"
            SignalToNoiseRatio.real = "root.LANDevice.1.WLANConfiguration.1.AssociatedDevice.%i.X_FH_SNR"
            Stats {
              Downstream {
                Bytes.real = "root.LANDevice.1.WLANConfiguration.1.AssociatedDevice.%i.X_FH_BytesReceived"
                Packets.real = "root.LANDevice.1.WLANConfiguration.1.AssociatedDevice.%i.X_FH_PacketsReceived"
                LastDataRate.real = "root.LANDevice.1.WLANConfiguration.1.AssociatedDevice.%i.X_FH_RxRate"
              }
              Upstream {
                Bytes.real = "root.LANDevice.1.WLANConfiguration.1.AssociatedDevice.%i.X_FH_BytesSent"
                Packets.real = "root.LANDevice.1.WLANConfiguration.1.AssociatedDevice.%i.X_FH_PacketsSent"
                LastDataRate.real = "root.LANDevice.1.WLANConfiguration.1.AssociatedDevice.%i.X_FH_TxRate"
              }
            }
          }
        }
        2 {
          Enable.real = "root.LANDevice.1.WLANConfiguration.5.Enable"
          SSID.real = "root.LANDevice.1.WLANConfiguration.5.SSID"
          Password.real = "root.LANDevice.1.WLANConfiguration.5.PreSharedKey.1.KeyPassphrase"
          Channel.real = "root.LANDevice.1.WLANConfiguration.5.Channel"
          AutoChannelEnable.real = "root.LANDevice.1.WLANConfiguration.5.AutoChannelEnable"
          AssociatedDevice.%i {
            MACAddress.real = "root.LANDevice.1.WLANConfiguration.5.AssociatedDevice.%i.AssociatedDeviceMACAddress"
            AuthenticationState.real = "root.LANDevice.1.WLANConfiguration.5.AssociatedDevice.%i.AssociatedDeviceAuthenticationState"
            IPAddress.real = "root.LANDevice.1.WLANConfiguration.5.AssociatedDevice.%i.AssociatedDeviceIPAddress"
            SignalStrength.real = "root.LANDevice.1.WLANConfiguration.5.AssociatedDevice.%i.X_FH_RSSI"
            SignalToNoiseRatio.real = "root.LANDevice.1.WLANConfiguration.5.AssociatedDevice.%i.X_FH_SNR"
            Stats {
              Downstream {
                Bytes.real = "root.LANDevice.1.WLANConfiguration.5.AssociatedDevice.%i.X_FH_BytesReceived"
                Packets.real = "root.LANDevice.1.WLANConfiguration.5.AssociatedDevice.%i.X_FH_PacketsReceived"
                LastDataRate.real = "root.LANDevice.1.WLANConfiguration.5.AssociatedDevice.%i.X_FH_RxRate"
              }
              Upstream {
                Bytes.real = "root.LANDevice.1.WLANConfiguration.5.AssociatedDevice.%i.X_FH_BytesSent"
                Packets.real = "root.LANDevice.1.WLANConfiguration.5.AssociatedDevice.%i.X_FH_PacketsSent"
                LastDataRate.real = "root.LANDevice.1.WLANConfiguration.5.AssociatedDevice.%i.X_FH_TxRate"
              }
            }
          }
        }
        5 {
          Enable.real = "root.LANDevice.1.WLANConfiguration.5.Enable"
          SSID.real = "root.LANDevice.1.WLANConfiguration.5.SSID"
          Password.real = "root.LANDevice.1.WLANConfiguration.5.PreSharedKey.1.KeyPassphrase"
          Channel.real = "root.LANDevice.1.WLANConfiguration.5.Channel"
          AutoChannelEnable.real = "root.LANDevice.1.WLANConfiguration.5.AutoChannelEnable"
          Name.real = "5 GHz"
          AssociatedDevice.%i {
            MACAddress.real = "root.LANDevice.1.WLANConfiguration.5.AssociatedDevice.%i.AssociatedDeviceMACAddress"
            AuthenticationState.real = "root.LANDevice.1.WLANConfiguration.5.AssociatedDevice.%i.AssociatedDeviceAuthenticationState"
            IPAddress.real = "root.LANDevice.1.WLANConfiguration.5.AssociatedDevice.%i.AssociatedDeviceIPAddress"
            SignalStrength.real = "root.LANDevice.1.WLANConfiguration.5.AssociatedDevice.%i.X_FH_RSSI"
            SignalToNoiseRatio.real = "root.LANDevice.1.WLANConfiguration.5.AssociatedDevice.%i.X_FH_SNR"
            Stats {
              Downstream {
                Bytes.real = "root.LANDevice.1.WLANConfiguration.5.AssociatedDevice.%i.X_FH_BytesReceived"
                Packets.real = "root.LANDevice.1.WLANConfiguration.5.AssociatedDevice.%i.X_FH_PacketsReceived"
                LastDataRate.real = "root.LANDevice.1.WLANConfiguration.5.AssociatedDevice.%i.X_FH_RxRate"
              }
              Upstream {
                Bytes.real = "root.LANDevice.1.WLANConfiguration.5.AssociatedDevice.%i.X_FH_BytesSent"
                Packets.real = "root.LANDevice.1.WLANConfiguration.5.AssociatedDevice.%i.X_FH_PacketsSent"
                LastDataRate.real = "root.LANDevice.1.WLANConfiguration.5.AssociatedDevice.%i.X_FH_TxRate"
              }
            }
          }
        }
      }


      WAN.GPON {
        %i = null
        1 {
          Status.real = ${remappingStrategy.activeKey.gpon}.Status
          BiasCurrent.real = ${remappingStrategy.activeKey.gpon}.BiasCurrent
          TransceiverTemperature.real = ${remappingStrategy.activeKey.gpon}.TransceiverTemperature
          RXPower.real = ${remappingStrategy.activeKey.gpon}.RXPower
          TXPower.real = ${remappingStrategy.activeKey.gpon}.TXPower
          SupplyVoltage.real = ${remappingStrategy.activeKey.gpon}.SupplyVoltage
          Stats {
            DropPackets.real = ${remappingStrategy.activeKey.gpon}.Stats.DropPackets
            FECError.real = ${remappingStrategy.activeKey.gpon}.Stats.FECError
            HECError.real = ${remappingStrategy.activeKey.gpon}.Stats.HECError
            Downstream {
              BroadcastPackets.real = ${remappingStrategy.activeKey.gpon}.Stats.RBroadcastPackets
              MulticastPackets.real = ${remappingStrategy.activeKey.gpon}.Stats.RMulticastPackets
              PausePackets.real = ${remappingStrategy.activeKey.gpon}.Stats.RPausePackets
              UnicastPackets.real = ${remappingStrategy.activeKey.gpon}.Stats.RUnicastPackets
            }
            Upstream {
              BroadcastPackets.real = ${remappingStrategy.activeKey.gpon}.Stats.SBroadcastPackets
              MulticastPackets.real = ${remappingStrategy.activeKey.gpon}.Stats.SMulticastPackets
              PausePackets.real = ${remappingStrategy.activeKey.gpon}.Stats.SPausePackets
              UnicastPackets.real = ${remappingStrategy.activeKey.gpon}.Stats.SUnicastPackets
            }
          }
        }
      }
    }
  }
}
virtualPatching.patching {
  root.X_AVS_EXT {
    LAN {
      %force-object-exists = true
      Devices.%force-object-exists = true
    }
    WiFi {
      %any {
        SupportedStandards.%force-value = "b,g,n"
        AssociatedDevice.%any {
          # Force create parameters that don't exist in datamodel
          SignalStrength.%force-object-exists = true
          SignalToNoiseRatio.%force-object-exists = true
          Stats {
            %force-object-exists = true
            Downstream {
              %force-object-exists = true
              Bytes.%force-object-exists = true
              Packets.%force-object-exists = true
              LastDataRate {
                %force-object-exists = true
                %patch-value = "${node.value.toInt * 1000}"
              }
            }
            Upstream {
              %force-object-exists = true
              Bytes.%force-object-exists = true
              Packets.%force-object-exists = true
              LastDataRate {
                %force-object-exists = true
                %patch-value = "${node.value.toInt * 1000}"
              }
            }
          }
        }
      }
    }
  }
}
