# Default strategies for CWMP
include "cwmp.strategies"

# CPE STATUS & MONITORING
include "cwmp.capabilities.generic.dm2"
include "cwmp.capabilities.management.dm2"
include "cwmp.capabilities.resources.dm2"
include "cwmp.capabilities.status.dm2"
include "cwmp.capabilities.temperature.dm2"
include "cwmp.capabilities.syslog.dm2"

# INTERNET ACCESS
include "cwmp.capabilities.ethernet.dm2"
include "cwmp.capabilities.wan.dm2"

# AVAILABLE FEATURES & SERVICES
include "cwmp.capabilities.bridging.dm2"
include "cwmp.capabilities.dhcp.dm2"
include "cwmp.capabilities.dns.dm2"
include "cwmp.capabilities.firewall.dm2"
include "cwmp.capabilities.forwarding.dm2"
include "cwmp.capabilities.lan.dm2"
include "cwmp.capabilities.ntp.dm2"
include "cwmp.capabilities.users.dm2"
include "capabilities.wifi"

# DIAGNOSTICS
include "capabilities.diagnostics"
include "cwmp.capabilities.diagnostics.dm2"

# WIFI Neigborhood DM2
include "cwmp.capabilities.neighborhood.dm2"

remappingStrategy {
  read_converter {
    #Convert value ke uppercase
    Manufacturer {
      expression = """${singleValue.toUpperCase()}"""
      type = expression
    }
    WAN.Internet {
      Status= ${tools.expression} {
        expression = """${if(singleValue.contains('Up')) 'Connected'
        else if(set('Down', 'Disabled').exists(singleValue.contains(_))) 'Disconnected'
        else 'Unconfigured'}"""
      }
      Mac {
        expression = "${singleValue.replaceAll(\":\",\"\")}"
        type = expression
      }
    }
  }

  mapping {
    root.X_AVS_EXT {
      LAN {
        Port.%i {
          Alias.real = "root.Ethernet.Interface.%i.Alias"
          DuplexMode.real = "root.Ethernet.Interface.%i.DuplexMode"
          Enabled.real = "root.Ethernet.Interface.%i.Enable"
          MACAddress.real = "root.Ethernet.Interface.%i.MACAddress"
          Name.real = "root.Ethernet.Interface.%i.Name"
          Status.real = "root.Ethernet.Interface.%i.Status"
          Upstream.real = "root.Ethernet.Interface.%i.Upstream"
          MaxBitRate.real = "root.Ethernet.Interface.%i.MaxBitRate"
          Stats {
            Downstream {
              Bytes.real = "root.Ethernet.Interface.%i.Stats.BytesReceived"
              Packets.real = "root.Ethernet.Interface.%i.Stats.PacketsReceived"
            }
            Upstream {
              Bytes.real = "root.Ethernet.Interface.%i.Stats.BytesSent"
              Packets.real = "root.Ethernet.Interface.%i.Stats.PacketsSent"
            }
          }
        }
        IP.1.IPv4.1 {
          Alias.real = "root.DHCPv4.Server.Pool.1.Alias"
          DNSServers.real = "root.DHCPv4.Server.Pool.1.DNSServers"
          Enable.real = "root.DHCPv4.Server.Pool.1.Enable"
          Address.real = "root.DHCPv4.Server.Pool.1.IPRouters"
          MaxAddress.real = "root.DHCPv4.Server.Pool.1.MaxAddress"
          MinAddress.real = "root.DHCPv4.Server.Pool.1.MinAddress"
          Status.real = "root.DHCPv4.Server.Pool.1.Status"
          SubnetMask.real = "root.DHCPv4.Server.Pool.1.SubnetMask"
          LeaseTime.real = "root.DHCPv4.Server.Pool.1.LeaseTime"
        }
      }
      WAN {
        UpTime.real = "root.IP.Interface.2.Uptime"
        AddressingType.real = "root.IP.Interface.2.X_TP_ConnType"
        Stats {
          Downstream {
            Bytes.real = "root.Ethernet.VLANTermination.1.Stats.BytesReceived"
            Packets.real = "root.Ethernet.VLANTermination.1.Stats.PacketsReceived"
          }
          Upstream {
            Bytes.real = "root.Ethernet.VLANTermination.1.Stats.BytesSent"
            Packets.real = "root.Ethernet.VLANTermination.1.Stats.PacketsSent"
          }
        }
        Internet {
          Status.real = "root.Ethernet.Link.2.Status"
          Mac.real = "root.Ethernet.Link.2.MACAddress"
          Address.real = "root.IP.Interface.2.IPv4Address.1.IPAddress"
          Gateway.real = "root.IP.Interface.2.IPv4Address.1.X_TP_Gateway"
        }
        IP {
          Name.real = "root.IP.Interface.2.IPv4Address.1.Alias"
          AddressingType.real = "root.IP.Interface.2.IPv4Address.1.AddressingType"
          Enable.real = "root.IP.Interface.2.IPv4Address.1.Enable"
          Address.real = "root.IP.Interface.2.IPv4Address.1.IPAddress"
          SubnetMask.real = "root.IP.Interface.2.IPv4Address.1.SubnetMask"
          Status.real = "root.IP.Interface.2.IPv4Address.1.Status"
          DefaultGateway.real = "root.IP.Interface.2.IPv4Address.1.X_TP_Gateway"
          UpTime.real = "root.IP.Interface.2.Uptime"
          Stats {
            Downstream {
              Bytes.real = "root.Ethernet.VLANTermination.1.Stats.BytesReceived"
              Packets.real = "root.Ethernet.VLANTermination.1.Stats.PacketsReceived"
            }
            Upstream {
              Bytes.real = "root.Ethernet.VLANTermination.1.Stats.BytesSent"
              Packets.real = "root.Ethernet.VLANTermination.1.Stats.PacketsSent"
            }
          }
        }
      }
      WiFi {
        1 {
          AutoChannelEnable.real = "root.WiFi.Radio.1.AutoChannelEnable"
          BSSID.real = "root.WiFi.SSID.1.BSSID"
          Band.real = "root.WiFi.Radio.1.OperatingFrequencyBand"
          Channel.real = "root.WiFi.Radio.1.Channel"
          Enable.real = "root.WiFi.Radio.1.Enable"
          Password.real = "root.WiFi.AccessPoint.1.Security.KeyPassphrase"
          PossibleChannels.real = "root.WiFi.Radio.1.PossibleChannels"
          PossibleSecurities.real = "root.WiFi.AccessPoint.1.Security.ModesSupported"
          Power.real = "root.WiFi.Radio.1.TransmitPower"
          RegulatoryDomain.real = "root.WiFi.Radio.1.RegulatoryDomain"
          SSID.real = "root.WiFi.SSID.1.SSID"
          Security.real = "root.WiFi.AccessPoint.1.Security.ModeEnabled"
          Standard.real = "root.WiFi.Radio.1.OperatingStandards"
          Status.real = "root.WiFi.Radio.1.Status"
          SupportedStandards.real = "root.WiFi.Radio.1.SupportedStandards"
          TotalAssociations.real = "root.WiFi.AccessPoint.1.AssociatedDeviceNumberOfEntries"
          TransmitPowerSupported.real = "root.WiFi.Radio.1.TransmitPowerSupported"
          WMMCapability.real = "root.WiFi.AccessPoint.1.WMMCapability"
          WMMEnable.real = "root.WiFi.AccessPoint.1.WMMEnable"
          Stats {
            Downstream {
              Bytes.real = "root.WiFi.SSID.1.Stats.BytesReceived"
              Packets.real = "root.WiFi.SSID.1.Stats.PacketsReceived"
            }
            Upstream {
              Bytes.real = "root.WiFi.SSID.1.Stats.BytesSent"
              Packets.real = "root.WiFi.SSID.1.Stats.PacketsSent"
            }
          }
          AssociatedDevice.%i {
            MACAddress.real = "root.WiFi.AccessPoint.1.AssociatedDevice.%i.MACAddress"
            Stats {
              Bytes.real = "root.WiFi.AccessPoint.1.AssociatedDevice.%i.Stats.PacketsReceived"
              Packets.real = "root.WiFi.AccessPoint.1.AssociatedDevice.%i.Stats.PacketsSent"
            }
          }
          Neighborhood.%i {
            BSSID.real = "root.WiFi.NeighboringWiFiDiagnostic.Result.%i.BSSID"
            Channel.real = "root.WiFi.NeighboringWiFiDiagnostic.Result.%i.Channel"
            EncryptionMode = "root.WiFi.NeighboringWiFiDiagnostic.Result.%i.EncryptionMode"
            Bandwidth.real = "root.WiFi.NeighboringWiFiDiagnostic.Result.%i.OperatingChannelBandwidth"
            Frequency.real = "root.WiFi.NeighboringWiFiDiagnostic.Result.%i.OperatingFrequencyBand"
            SSID.real = "root.WiFi.NeighboringWiFiDiagnostic.Result.%i.SSID"
            Security.real = "root.WiFi.NeighboringWiFiDiagnostic.Result.%i.SecurityModeEnabled"
            SignalStrength.real = "root.WiFi.NeighboringWiFiDiagnostic.Result.%i.SignalStrength"
          }
        }
        5 {
          AutoChannelEnable.real = "root.WiFi.Radio.2.AutoChannelEnable"
          BSSID.real = "root.WiFi.SSID.3.BSSID"
          Band.real = "root.WiFi.Radio.2.OperatingFrequencyBand"
          Channel.real = "root.WiFi.Radio.2.Channel"
          Enable.real = "root.WiFi.Radio.2.Enable"
          Password.real = "root.WiFi.AccessPoint.3.Security.KeyPassphrase"
          PossibleChannels.real = "root.WiFi.Radio.2.PossibleChannels"
          PossibleSecurities.real = "root.WiFi.AccessPoint.3.Security.ModesSupported"
          Power.real = "root.WiFi.Radio.2.TransmitPower"
          RegulatoryDomain.real = "root.WiFi.Radio.2.RegulatoryDomain"
          SSID.real = "root.WiFi.SSID.3.SSID"
          Security.real = "root.WiFi.AccessPoint.3.Security.ModeEnabled"
          Standard.real = "root.WiFi.Radio.2.OperatingStandards"
          Status.real = "root.WiFi.Radio.2.Status"
          SupportedStandards.real = "root.WiFi.Radio.2.SupportedStandards"
          TotalAssociations.real = "root.WiFi.AccessPoint.3.AssociatedDeviceNumberOfEntries"
          TransmitPowerSupported.real = "root.WiFi.Radio.2.TransmitPowerSupported"
          WMMCapability.real = "root.WiFi.AccessPoint.3.WMMCapability"
          WMMEnable.real = "root.WiFi.AccessPoint.3.WMMEnable"
          Stats {
            Downstream {
              Bytes.real = "root.WiFi.SSID.3.Stats.BytesReceived"
              Packets.real = "root.WiFi.SSID.3.Stats.PacketsReceived"
            }
            Upstream {
              Bytes.real = "root.WiFi.SSID.3.Stats.BytesSent"
              Packets.real = "root.WiFi.SSID.3.Stats.PacketsSent"
            }
          }
          AssociatedDevice.%i {
            MACAddress.real = "root.WiFi.AccessPoint.3.AssociatedDevice.%i.MACAddress"
            Stats {
              Bytes.real = "root.WiFi.AccessPoint.3.AssociatedDevice.%i.Stats.PacketsReceived"
              Packets.real = "root.WiFi.AccessPoint.3.AssociatedDevice.%i.Stats.PacketsSent"
            }
          }
          Neighborhood.%i {
            BSSID.real = "root.WiFi.NeighboringWiFiDiagnostic.Result.%i.BSSID"
            Channel.real = "root.WiFi.NeighboringWiFiDiagnostic.Result.%i.Channel"
            EncryptionMode = "root.WiFi.NeighboringWiFiDiagnostic.Result.%i.EncryptionMode"
            Bandwidth.real = "root.WiFi.NeighboringWiFiDiagnostic.Result.%i.OperatingChannelBandwidth"
            Frequency.real = "root.WiFi.NeighboringWiFiDiagnostic.Result.%i.OperatingFrequencyBand"
            SSID.real = "root.WiFi.NeighboringWiFiDiagnostic.Result.%i.SSID"
            Security.real = "root.WiFi.NeighboringWiFiDiagnostic.Result.%i.SecurityModeEnabled"
            SignalStrength.real = "root.WiFi.NeighboringWiFiDiagnostic.Result.%i.SignalStrength"
          }
        }
      }
    }
  }
}

virtualPatching {
  patching {
    root.X_AVS_EXT {
      Capabilities.WiFi.%force-value = "true"
      Capabilities.Neighborhood.%force-value = "true"
      WiFi {
        1.Band.%force-value = "2.4"
        5.Band.%force-value = "5"
      }
    }
  }
}