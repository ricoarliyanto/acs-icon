# FIXES
# No fixes by default

# Device doesn't have any capabilities we can rely on in default dialect.
# All capabilities are set to false in cwmp.default. (except Backup/Restore)
include "capabilities"
virtualPatching.patching {
  root.X_AVS_EXT.Capabilities {
    Backup.%force-value = "true"
    Reboot.%force-value = "true"
    Restore.%force-value = "true"
  }
}

remappingStrategy {
  read_converter {
    # remember that read converter works after mapping and before virtual patching
    # Converters were using expression and multiplying the numbers, currenlty we have mac addresses under the lastDataRate not numbers :()
    # they would fail the conversion action and they wouldn't alert it anywhere 
    WiFi.%any.AssociatedDevice.%any.Stats.Downstream.LastDataRate = null
    WiFi.%any.AssociatedDevice.%any.Stats.Upstream.LastDataRate = null
  } 
  mapping {
    root.X_AVS_EXT {
      WiFiNeighborhood {
        State.real = "root.WiFi.NeighboringWiFiDiagnostic.DiagnosticsState"
      }
    }
  }
}