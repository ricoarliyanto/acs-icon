# Default strategies for CWMP
include "cwmp.strategies"

# CPE STATUS & MONITORING
include "cwmp.capabilities.generic"
include "cwmp.capabilities.management"
include "cwmp.capabilities.status"
include "cwmp.capabilities.temperature"
include "cwmp.capabilities.syslog"
include "cwmp.ext.syslog.hw"
include "cwmp.capabilities.resources"
include "cwmp.capabilities.process"

# INTERNET ACCESS
include "cwmp.capabilities.ppp"
include "cwmp.capabilities.wan"
include "cwmp.capabilities.gpon"
include "cwmp.ext.wan.gpon.huawei"


# AVAILABLE FEATURES & SERVICES
include "cwmp.capabilities.routing"
include "cwmp.capabilities.forwarding"
include "cwmp.capabilities.ntp"
include "cwmp.capabilities.wifi"
include "cwmp.capabilities.lan"
include "cwmp.capabilities.dhcp"
include "cwmp.capabilities.voip"
include "cwmp.capabilities.firewall"
include "cwmp.ext.firewall.hw"

# DIAGNOSTICS
include "cwmp.capabilities.diagnostics"
include "cwmp.capabilities.neighborhood"
include "cwmp.ext.wifi.neighborhood.huawei"


# CONFIGURATION MANAGEMENT
include "cwmp.capabilities.backup"
include "cwmp.capabilities.restore"

# MAINTENANCE
include "cwmp.capabilities.reboot"

virtualPatching.patching {
  root.X_AVS_EXT {
    WiFiNeighborhood.%any.ChannelBandwidth.%force-value = "20"
  }
}


virtualPatching.patching {
  root.X_AVS_EXT.Capabilities.Diagnostics {
    "%force-value"="true"
  }
}

remappingStrategy{
  activeKey.gpon = "root.WANDevice.1.X_CT-COM_GponInterfaceConfig"

  mapping {
    root.X_AVS_EXT{
      WiFi.%i {
        Enable.real = "root.LANDevice.1.WLANConfiguration.%i.RadioEnabled"
        Password.real = "root.LANDevice.1.WLANConfiguration.%i.PreSharedKey.1.KeyPassphrase"
        Security.real = "root.LANDevice.1.WLANConfiguration.%i.BeaconType"
      }
      WiFiNeighborhood.%i {
        BSSID.real = "root.LANDevice.1.WLANConfiguration.%i.BSSID"
        Channel.real = "root.LANDevice.1.WLANConfiguration.%i.Channel"
        SSID.real = "root.LANDevice.1.WLANConfiguration.%i.SSID"
        Standard.real = "root.LANDevice.1.WLANConfiguration.%i.Standard"
        ChannelBandwidth.real = "root.LANDevice.1.WLANConfiguration.%i.X_CT-COM_ChannelWidth"
      }
      WAN.GPON.%j {
        BiasCurrent.real = "root.WANDevice.%j.X_CT-COM_GponInterfaceConfig.BiasCurrent"
        Enable.real = "root.WANDevice.%j.WANCommonInterfaceConfig.EnabledForInternet"
        MACAddress.real = "root.WANDevice.%j.WANConnectionDevice.1.WANPPPConnection.1.MACAddress"
        RXPower.real = "root.WANDevice.%j.X_CT-COM_GponInterfaceConfig.RXPower"
        Status.real = "root.WANDevice.%j.WANCommonInterfaceConfig.PhysicalLinkStatus"
        SupplyVoltage.real = "root.WANDevice.%j.X_CT-COM_GponInterfaceConfig.SupplyVottage"
        TXPower.real = "root.WANDevice.%j.X_CT-COM_GponInterfaceConfig.TXPower"
        TransceiverTemperature.real = "root.WANDevice.%j.X_CT-COM_GponInterfaceConfig.TransceiverTemperature"
        Stats.DropPackets.real = "root.WANDevice.%j.X_CT-COM_GponInterfaceConfig.Stats.DropPackets"
        Stats.FECError.real = "root.WANDevice.%j.X_CT-COM_GponInterfaceConfig.Stats.FECError"
        Stats.HECError.real = "root.WANDevice.%j.X_CT-COM_GponInterfaceConfig.Stats.HECError"
        Stats.Downstream.BroadcastPackets.real = "root.WANDevice.%j.X_CT-COM_GponInterfaceConfig.Stats.RBroadcastPackets"
        Stats.Downstream.Bytes.real = "root.WANDevice.%j.X_CT-COM_GponInterfaceConfig.Stats.BytesReceived"
        Stats.Downstream.MulticastPackets.real = "root.WANDevice.%j.X_CT-COM_GponInterfaceConfig.Stats.RMulticastPackets"
        Stats.Downstream.Packets.real = "root.WANDevice.%j.X_CT-COM_GponInterfaceConfig.Stats.PacketsReceived"
        Stats.Downstream.PausePackets.real = "root.WANDevice.%j.X_CT-COM_GponInterfaceConfig.Stats.RpausePackets"
        Stats.Downstream.UnicastPackets.real = "root.WANDevice.%j.X_CT-COM_GponInterfaceConfig.Stats.RUnicastPackets"
        Stats.Upstream.BroadcastPackets.real = "root.WANDevice.%j.X_CT-COM_GponInterfaceConfig.Stats.SBroadcastPackets"
        Stats.Upstream.Bytes.real = "root.WANDevice.%j.X_CT-COM_GponInterfaceConfig.Stats.BytesSent"
        Stats.Upstream.MulticastPackets.real = "root.WANDevice.%j.X_CT-COM_GponInterfaceConfig.Stats.SMulticastPackets"
        Stats.Upstream.Packets.real = "root.WANDevice.%j.X_CT-COM_GponInterfaceConfig.Stats.PacketsSent"
        Stats.Upstream.PausePackets.real = "root.WANDevice.%j.X_CT-COM_GponInterfaceConfig.Stats.SpausePackets"
        Stats.Upstream.UnicastPackets.real = "root.WANDevice.%j.X_CT-COM_GponInterfaceConfig.Stats.SUnicastPackets"
      }
    }
  }
}
