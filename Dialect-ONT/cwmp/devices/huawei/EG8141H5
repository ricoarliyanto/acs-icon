#fixing that results from wifi scan are mixed (2.4 and 5)

NeighborhoodPatching {
  %force-object-exists = true
  %override-tree = true
  %foreach-x {
    Band.%force-value = "${dm.`LANDevice.1.WiFi.NeighboringWiFiDiagnostic`.Result.get(#x).OperatingFrequencyBand.value}"
    BSSID.%force-value = "${dm.`LANDevice.1.WiFi.NeighboringWiFiDiagnostic`.Result.get(#x).BSSID.value}"
    Channel.%force-value = "${dm.`LANDevice.1.WiFi.NeighboringWiFiDiagnostic`.Result.get(#x).Channel.value}"
    SSID.%force-value = "${dm.`LANDevice.1.WiFi.NeighboringWiFiDiagnostic`.Result.get(#x).SSID.value}"
    SignalStrength.%force-value = "${dm.`LANDevice.1.WiFi.NeighboringWiFiDiagnostic`.Result.get(#x).SignalStrength.value}"
    Security.%force-value = "${dm.`LANDevice.1.WiFi.NeighboringWiFiDiagnostic`.Result.get(#x).SecurityModeEnabled.value}"
    Standard.%force-value = "${dm.`LANDevice.1.WiFi.NeighboringWiFiDiagnostic`.Result.get(#x).OperatingStandards.value}"
    OperatingChannelBandwidth.%force-value = "${dm.`LANDevice.1.WiFi.NeighboringWiFiDiagnostic`.Result.get(#x).OperatingChannelBandwidth.value}"
  }
}

NeighborhoodPatching24  = ${NeighborhoodPatching}{
  %foreach-x {
    %in = """${dm.`LANDevice.1.WiFi.NeighboringWiFiDiagnostic`.Result.any.keys.filter(
                  x => dm.getByPath(x+'Channel').value.toInt <= 13
                 ).map(k => k.keyName)}"""
  }
}

NeighborhoodPatching50 = ${NeighborhoodPatching} {
  %foreach-x {
    %in = """${dm.`LANDevice.1.WiFi.NeighboringWiFiDiagnostic`.Result.any.keys.filter(
                  x => dm.getByPath(x+'Channel').value.toInt >= 30
                 ).map(k => k.keyName)}"""
  }
}

virtualPatching.patching.root.X_AVS_EXT.WiFi.%any.AssociatedDevice.%any {
  Stats.Downstream.LastDataRate.%patch-value = "${node.value.toInt * 1000}"
  Stats.Upstream.LastDataRate.%patch-value = "${node.value.toInt * 1000}"
}

virtualPatching.patching {
  root.X_AVS_EXT.WiFi {
    1 {
      Neighborhood = ${NeighborhoodPatching24}
      # fixing standards - VDM accepts only 'b,g,n' format, but RDM uses '11bgn'
      Standard {
        # patch-value - fixes VDM format. It will display 'b,g,n' - expression is modifying '11bgn' into 'b,g,n'
        %patch-value = "${node.value.drop(2).splitBy('').join(',')}" # b,g,n
        # patch-outgoing-value - sending value from VDM to RDM - fixes RDM format - picking any standard in CC it will start it with '11' - expression is modifying 'b,g,n' into '11bgn'
        %patch-outgoing-value = "${node.value.splitBy(',').join.reverse.concat('11').reverse}" # bgn -> ngb -> ngb11 -> 11bgn
      }
      SupportedStandards {
        %force-value = "b,g,n"
      }
      PossibleSecurities {
        %force-type = "xsd:string"
        %force-value = "NONE,WPA,WPA2,WPA_WPA2"
      }

      ChannelWidth {
        %force-writable = true
      }
    }
    2 {
      Neighborhood =  ${NeighborhoodPatching50} #a; a,n; ac; a,n,ac
      Standard {
        # patching to value with format: a,n,ac
        %patch-value = "${if(node.value == '11ac') node.value.drop(2) else if(node.value == '11anac') node.value.drop(2).reverse.drop(2).reverse.splitBy('').join(',').concat(',ac') else node.value.drop(2).splitBy('').join(',')}"
        # patching to value with format: 11anac
        %patch-outgoing-value = "${if(node.value == 'ac') node.value.reverse.concat('11').reverse else node.value.splitBy(',').join.reverse.concat('11').reverse}"
      }
      SupportedStandards {
        %force-value = "a,n,ac"
      }
      PossibleSecurities {
        %force-type = "xsd:string"
        %force-value = "NONE,WPA,WPA2,WPA_WPA2"
      }

      ChannelWidth {
        %force-writable = true
      }
    }
    root.X_AVS_EXT.Capabilities.IPTV {
      %force-object-exists = true
    }
    root.X_AVS_EXT.LAN.Devices.1.IPAddress {
      "%force-object-exists" = true
    }
  }
}

