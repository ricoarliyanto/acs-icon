remappingStrategy {
  wifiSecurity {
    // Expression check if all real key values are set to NONE
    isNone = """if(
      realValue('BeaconType') == 'Basic' and
      realValue('BasicEncryptionModes') == 'None' and
      realValue('BasicAuthenticationMode') == 'None'
    ) 'NONE'"""

    // Expresion return proper value for relevant real key to set NONE
    setNone = """if(value == 'NONE')(
      map('BeaconType' -> 'Basic',
          'BasicEncryptionModes' -> 'None',
          'BasicAuthenticationMode' -> 'None',
          'WPAEncryptionModes' -> 'TKIPEncryption',
          'WPAAuthenticationMode' -> 'PSKAuthentication',
          'IEEE11iEncryptionModes' -> 'AESEncryption',
          'IEEE11iAuthenticationMode' -> 'PSKAuthentication'
      ).get(key.keyName)
    )"""

    // Expression check if all real key values are set to WPA
    isWpa = """if(
      realValue('BeaconType') == 'WPA' and
      realValue('WPAEncryptionModes') == 'TKIPEncryption' and
      realValue('WPAAuthenticationMode') == 'PSKAuthentication'
    ) 'WPA'"""

    // Expresion return proper value for relevant real key to set WPA
    setWpa = """if(value == 'WPA')(
      map('BeaconType' -> 'WPA',
          'WPAEncryptionModes' -> 'TKIPEncryption',
          'WPAAuthenticationMode' -> 'PSKAuthentication',
          'BasicEncryptionModes' -> 'None',
          'BasicAuthenticationMode' -> 'None',
          'IEEE11iEncryptionModes' -> 'AESEncryption',
          'IEEE11iAuthenticationMode' -> 'PSKAuthentication'
      ).get(key.keyName)
    )"""

    // Expression check if all real key values are set to WPA2
    isWpa2 = """if(
      realValue('BeaconType') == '11i' and
      realValue('IEEE11iEncryptionModes') == 'AESEncryption' and
      realValue('IEEE11iAuthenticationMode') == 'PSKAuthentication'
    ) 'WPA2'"""

    // Expresion return proper value for relevant real key to set WPA2
    setWpa2 = """if(value == 'WPA2')(
      map('BeaconType' -> '11i',
          'IEEE11iEncryptionModes' -> 'AESEncryption',
          'IEEE11iAuthenticationMode' -> 'PSKAuthentication',
          'WPAEncryptionModes' -> 'TKIPEncryption',
          'WPAAuthenticationMode' -> 'PSKAuthentication',
          'BasicEncryptionModes' -> 'None',
          'BasicAuthenticationMode' -> 'None'
      ).get(key.keyName)
    )"""

    // Expression check if all real key values are set to WPA_WPA2
    isWpa_Wpa2 = """if(
      realValue('BeaconType') == 'WPAand11i' and
      realValue('WPAEncryptionModes') == 'TKIPEncryption' and
      realValue('WPAAuthenticationMode') == 'PSKAuthentication' and
      realValue('IEEE11iEncryptionModes') == 'AESEncryption' and
      realValue('IEEE11iAuthenticationMode') == 'PSKAuthentication'
    ) 'WPA_WPA2'"""

    // Expresion return proper value for relevant real key to set WPA_WPA2
    setWpa_Wpa2 = """if(value == 'WPA_WPA2')(
      map('BeaconType' -> 'WPAand11i',
          'WPAEncryptionModes' -> 'TKIPEncryption',
          'WPAAuthenticationMode' -> 'PSKAuthentication',
          'IEEE11iEncryptionModes' -> 'AESEncryption',
          'IEEE11iAuthenticationMode' -> 'PSKAuthentication',
          'BasicEncryptionModes' -> 'None',
          'BasicAuthenticationMode' -> 'None'
      ).get(key.keyName)
    )"""
  }
  read_converter {
    WiFi.%i {
      Security = ${tools.expression} {
        expression = """${
          """${remappingStrategy.wifiSecurity.isNone}""" else
          """${remappingStrategy.wifiSecurity.isWpa}""" else
          """${remappingStrategy.wifiSecurity.isWpa2}""" else
          """${remappingStrategy.wifiSecurity.isWpa_Wpa2}""" else 'CUSTOM' }"""
      }
      ChannelWidth {
        expression = "${map('0'->'Auto','1'->'20','2'->'40','3'->'Auto').getOr(singleValue,'NONE')}"
        type = expression
      }
    }
    WAN.GPON.1.SupplyVoltage {
      expression =  "${singleValue.toLong / 1000.0}"
      "type" : "expression"
    }
  }
  write_converter {
    WiFi.%i {
      Security = ${tools.expression} {
        expression = """${
            """${remappingStrategy.wifiSecurity.setNone}""" else
            """${remappingStrategy.wifiSecurity.setWpa}""" else
            """${remappingStrategy.wifiSecurity.setWpa2}""" else
            """${remappingStrategy.wifiSecurity.setWpa_Wpa2}""" else null}"""
      }
    }
    Diagnostics.Download.DownloadURL = ${tools.expression} {
      expression = "${if (key.keyName == 'DownloadURL') value else '4'}"
    }
    WiFi.1 {
      ChannelWidth = ${tools.expression} {
        expression = "${map('Auto'->'0','20'->'1','40'->'2').get(value)}"
      }
    }
    WiFi.2 {
      ChannelWidth = ${tools.expression} {
        expression = "${map('Auto'->'3','20'->'1','40'->'2').get(value)}"
      }
    }
  }
  activeKey.gpon = "${sv.activeWan.toParameterKey}"
  activeKey.pon = "${sv.activeWan.ancestorKey(3).toParameterKey}.X_GponInterafceConfig"

  mapping {
    root.X_AVS_EXT.Diagnostics.Download.DownloadURL.real = ["root.DownloadDiagnostics.NumberOfConnections","root.DownloadDiagnostics.DownloadURL"]
    root.X_AVS_EXT.WAN.GPON.1 {
      Technology.real="root.WANDevice.1.WANCommonInterfaceConfig.WANAccessType"
    }
    root.X_AVS_EXT.LAN.Devices.1 {
      IPAddress.real="${sv.activeWan.toParameterKey}.ExternalIPAddress"
    }
    root.X_AVS_EXT.LAN {
      Port.%i {
        DuplexMode.real = ${remappingStrategy.activeKey.lan}.LANEthernetInterfaceConfig.%i.DuplexMode
      }
    }
    root.X_AVS_EXT {
      WiFi {
        1 {
          Enable.real = "root.LANDevice.1.WLANConfiguration.1.RadioEnabled"
          Password.real = "root.LANDevice.1.WLANConfiguration.1.PreSharedKey.1.KeyPassphrase"
          SupportedStandards.real = "root.LANDevice.1.WLANConfiguration.1.X_HW_SupportedStandards"
          ChannelWidth.real = "${sv.vdmWlan1.toParameterKey}.X_HW_HT20"
          Security.real = "root.LANDevice.1.WLANConfiguration.1.BeaconType"
          Neighborhood.%i {
            BSSID.real = "root.LANDevice.1.WiFi.Radio.1.X_HW_NeighborAP.%i.BSSID"
            Channel.real = "root.LANDevice.1.WiFi.Radio.1.X_HW_NeighborAP.%i.Channel"
            SSID.real = "root.LANDevice.1.WiFi.Radio.1.X_HW_NeighborAP.%i.SSID"
            Security.real = "root.LANDevice.1.WiFi.Radio.1.X_HW_NeighborAP.%i.Security"
            SignalStrength.real = "root.LANDevice.1.WiFi.Radio.1.X_HW_NeighborAP.%i.RSSI"
            Standard.real = "root.LANDevice.1.WiFi.Radio.1.X_HW_NeighborAP.%i.Standard"
            ChannelBandwidth.real = "root.LANDevice.1.WiFi.Radio.1.X_HW_NeighborAP.%i.ChannelWidth"
          }
          NoiseFloor.real = "${sv.vdmWlan1.toParameterKey}.AssociatedDevice.%i.X_HW_Noise"
          AssociatedDevice.%i {
            SignalStrength.real = "${sv.vdmWlan1.toParameterKey}.AssociatedDevice.%i.X_HW_RSSI"
            SignalToNoiseRatio.real = "${sv.vdmWlan1.toParameterKey}.AssociatedDevice.%i.X_HW_SNR"
            Stats {
              Downstream {
                LastDataRate.real = "${sv.vdmWlan1.toParameterKey}.AssociatedDevice.%i.X_HW_RxRate"
              }
              Upstream {
                LastDataRate.real = "${sv.vdmWlan1.toParameterKey}.AssociatedDevice.%i.X_HW_TxRate"
              }
            }
          }
        }
        2 {
          Enable.real = "root.LANDevice.1.WLANConfiguration.1.RadioEnabled"
          Password.real = "root.LANDevice.1.WLANConfiguration.5.PreSharedKey.1.KeyPassphrase"
          SupportedStandards.real = "root.LANDevice.1.WLANConfiguration.5.X_HW_SupportedStandards"
          ChannelWidth.real = "${sv.vdmWlan2.toParameterKey}.X_HW_HT20"
          Security.real = "root.LANDevice.1.WLANConfiguration.5.BeaconType"
          AssociatedDevice.%i {
            SignalStrength.real = "${sv.vdmWlan2.toParameterKey}.AssociatedDevice.%i.X_HW_RSSI"
            SignalToNoiseRatio.real = "${sv.vdmWlan2.toParameterKey}.AssociatedDevice.%i.X_HW_SNR"
            Stats {
              Downstream {
                LastDataRate.real = "${sv.vdmWlan2.toParameterKey}.AssociatedDevice.%i.X_HW_RxRate"
              }
              Upstream {
                LastDataRate.real = "${sv.vdmWlan2.toParameterKey}.AssociatedDevice.%i.X_HW_TxRate"
              }
            }
          }
          Neighborhood.%i {
            BSSID.real = "root.LANDevice.1.WiFi.Radio.2.X_HW_NeighborAP.%i.BSSID"
            Channel.real = "root.LANDevice.1.WiFi.Radio.2.X_HW_NeighborAP.%i.Channel"
            SSID.real = "root.LANDevice.1.WiFi.Radio.2.X_HW_NeighborAP.%i.SSID"
            Security.real = "root.LANDevice.1.WiFi.Radio.2.X_HW_NeighborAP.%i.Security"
            SignalStrength.real = "root.LANDevice.1.WiFi.Radio.2.X_HW_NeighborAP.%i.RSSI"
            Standard.real = "root.LANDevice.1.WiFi.Radio.2.X_HW_NeighborAP.%i.Standard"
            ChannelBandwidth.real = "root.LANDevice.1.WiFi.Radio.2.X_HW_NeighborAP.%i.ChannelWidth"
          }
        }
      }
      WAN {
        GPON.1 {
          Status.real = root.WANDevice.1.X_GponInterafceConfig.Status
          TransceiverTemperature.real = root.WANDevice.1.X_GponInterafceConfig.TransceiverTemperature
          Stats.Downstream.Bytes.real = root.WANDevice.1.X_GponInterafceConfig.Stats.BytesReceived
          Stats.Downstream.Packets.real = root.WANDevice.1.X_GponInterafceConfig.Stats.PacketsReceived
          Stats.Upstream.Bytes.real = root.WANDevice.1.X_GponInterafceConfig.Stats.BytesSent
          Stats.Upstream.Packets.real = root.WANDevice.1.X_GponInterafceConfig.Stats.PacketsSent
        }
        GPON.1 {
          BiasCurrent.real = ${remappingStrategy.activeKey.pon}".BiasCurrent"
          RXPower.real = ${remappingStrategy.activeKey.pon}".RXPower"
          TXPower.real = ${remappingStrategy.activeKey.pon}".TXPower"
          SupplyVoltage.real = ${remappingStrategy.activeKey.pon}".SupplyVoltage"
          Stats {
            DropPackets.real = ${remappingStrategy.activeKey.pon}".Stats.DropPackets"
            FECError.real = ${remappingStrategy.activeKey.pon}".Stats.FECError"
            HECError.real = ${remappingStrategy.activeKey.pon}".Stats.HECError"
            Downstream {
              BroadcastPackets.real = ${remappingStrategy.activeKey.pon}".Stats.RBroadcastPackets"
              MulticastPackets.real = ${remappingStrategy.activeKey.pon}".Stats.RMulticastPackets"
              PausePackets.real = ${remappingStrategy.activeKey.pon}".Stats.RPausePackets"
              UnicastPackets.real = ${remappingStrategy.activeKey.pon}".Stats.RUnicastPackets"
            }
            Upstream {
              BroadcastPackets.real = ${remappingStrategy.activeKey.pon}".Stats.SBroadcastPackets"
              MulticastPackets.real = ${remappingStrategy.activeKey.pon}".Stats.SMulticastPackets"
              PausePackets.real = ${remappingStrategy.activeKey.pon}".Stats.SPausePackets"
              UnicastPackets.real = ${remappingStrategy.activeKey.pon}".Stats.SUnicastPackets"
            }
          }
        }
      }
      LAN.Devices.%i.Stats.Downstream.BytesLocal.real = ${remappingStrategy.activeKey.lan}.Hosts.Host.%i.X_HW_Stats.BytesReceived
      LAN.Devices.%i.Stats.Upstream.BytesLocal.real = ${remappingStrategy.activeKey.lan}.Hosts.Host.%i.X_HW_Stats.BytesSent
    }
  }
}
