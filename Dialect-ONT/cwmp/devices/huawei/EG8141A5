remappingStrategy {
  wifiSecurity {
    // Expression check if all real key values are set to NONE
    isNone = """if(
      realValue('BeaconType') == 'Basic' and
      realValue('BasicEncryptionModes') == 'None' and
      realValue('BasicAuthenticationMode') == 'None'
    ) 'NONE'"""

    // Expresion return proper value for relevant real key to set NONE
    setNone = """if(value == 'NONE')(
      map('BeaconType' -> 'Basic',
          'BasicEncryptionModes' -> 'None',
          'BasicAuthenticationMode' -> 'None',
          'WPAEncryptionModes' -> 'TKIPEncryption',
          'WPAAuthenticationMode' -> 'PSKAuthentication',
          'IEEE11iEncryptionModes' -> 'AESEncryption',
          'IEEE11iAuthenticationMode' -> 'PSKAuthentication'
      ).get(key.keyName)
    )"""

    // Expression check if all real key values are set to WPA
    isWpa = """if(
      realValue('BeaconType') == 'WPA' and
      realValue('WPAEncryptionModes') == 'TKIPEncryption' and
      realValue('WPAAuthenticationMode') == 'PSKAuthentication'
    ) 'WPA'"""

    // Expresion return proper value for relevant real key to set WPA
    setWpa = """if(value == 'WPA')(
      map('BeaconType' -> 'WPA',
          'WPAEncryptionModes' -> 'TKIPEncryption',
          'WPAAuthenticationMode' -> 'PSKAuthentication',
          'BasicEncryptionModes' -> 'None',
          'BasicAuthenticationMode' -> 'None',
          'IEEE11iEncryptionModes' -> 'AESEncryption',
          'IEEE11iAuthenticationMode' -> 'PSKAuthentication'
      ).get(key.keyName)
    )"""

    // Expression check if all real key values are set to WPA2
    isWpa2 = """if(
      realValue('BeaconType') == '11i' and
      realValue('IEEE11iEncryptionModes') == 'AESEncryption' and
      realValue('IEEE11iAuthenticationMode') == 'PSKAuthentication'
    ) 'WPA2'"""

    // Expresion return proper value for relevant real key to set WPA2
    setWpa2 = """if(value == 'WPA2')(
      map('BeaconType' -> '11i',
          'IEEE11iEncryptionModes' -> 'AESEncryption',
          'IEEE11iAuthenticationMode' -> 'PSKAuthentication',
          'WPAEncryptionModes' -> 'TKIPEncryption',
          'WPAAuthenticationMode' -> 'PSKAuthentication',
          'BasicEncryptionModes' -> 'None',
          'BasicAuthenticationMode' -> 'None'
      ).get(key.keyName)
    )"""

    // Expression check if all real key values are set to WPA_WPA2
    isWpa_Wpa2 = """if(
      realValue('BeaconType') == 'WPAand11i' and
      realValue('WPAEncryptionModes') == 'TKIPEncryption' and
      realValue('WPAAuthenticationMode') == 'PSKAuthentication' and
      realValue('IEEE11iEncryptionModes') == 'AESEncryption' and
      realValue('IEEE11iAuthenticationMode') == 'PSKAuthentication'
    ) 'WPA_WPA2'"""

    // Expresion return proper value for relevant real key to set WPA_WPA2
    setWpa_Wpa2 = """if(value == 'WPA_WPA2')(
      map('BeaconType' -> 'WPAand11i',
          'WPAEncryptionModes' -> 'TKIPEncryption',
          'WPAAuthenticationMode' -> 'PSKAuthentication',
          'IEEE11iEncryptionModes' -> 'AESEncryption',
          'IEEE11iAuthenticationMode' -> 'PSKAuthentication',
          'BasicEncryptionModes' -> 'None',
          'BasicAuthenticationMode' -> 'None'
      ).get(key.keyName)
    )"""
  }
  read_converter {
    WiFi.%i {
      ChannelWidth {
        expression = "${map('0'->'Auto','1'->'20','2'->'40','3'->'Auto').getOr(singleValue,'NONE')}"
        type = expression
      }
      AssociatedDevice.%i {
        SignalStrength {
           expression = "${singleValue.toInt}"
           type = expression
        }
        SignalToNoiseRatio {
           expression = "${singleValue.toInt}"
           type = expression
        }
      }
      Security = ${tools.expression} {
        expression = """${
          """${remappingStrategy.wifiSecurity.isNone}""" else
          """${remappingStrategy.wifiSecurity.isWpa}""" else
          """${remappingStrategy.wifiSecurity.isWpa2}""" else
          """${remappingStrategy.wifiSecurity.isWpa_Wpa2}""" else 'CUSTOM' }"""
      }
    }
    WAN.GPON.1.SupplyVoltage {
      expression =  "${singleValue.toLong / 1000.0}"
      type = expression
    }
    System.cpeCpuUsed {
      expression = "${singleValue} %"
      type = expression
    }
    System.cpeMemUsed {
      expression = "${singleValue} %"
      type = expression
    }
  }

  write_converter {
    WiFi.%i {
      Security = ${tools.expression} {
        expression = """${
            """${remappingStrategy.wifiSecurity.setNone}""" else
            """${remappingStrategy.wifiSecurity.setWpa}""" else
            """${remappingStrategy.wifiSecurity.setWpa2}""" else
            """${remappingStrategy.wifiSecurity.setWpa_Wpa2}""" else null}"""
      }
    }
    Diagnostics.Download.DownloadURL = ${tools.expression} {
      expression = "${if (key.keyName == 'DownloadURL') value else '4'}"
    }
    WiFi.1 {
      ChannelWidth = ${tools.expression} {
        expression = "${map('Auto'->'0','20'->'1','40'->'2').get(value)}"
      }
    }
    WiFi.2 {
      ChannelWidth = ${tools.expression} {
        expression = "${map('Auto'->'3','20'->'1','40'->'2').get(value)}"
      }
    }
  }
  activeKey.gpon = "${sv.activeWan.toParameterKey}"
  activeKey.pon = "${sv.activeWan.ancestorKey(3).toParameterKey}.X_GponInterafceConfig"

  mapping {
    root.X_AVS_EXT.Diagnostics.Download.DownloadURL.real = ["root.DownloadDiagnostics.NumberOfConnections","root.DownloadDiagnostics.DownloadURL"]
    root.X_AVS_EXT.System {
      cpeCpuUsed.real = "root.DeviceInfo.X_HW_CpuUsed"
      cpeMemUsed.real = "root.DeviceInfo.X_HW_MemUsed"
    }

    root.X_AVS_EXT.WAN.Type.real = "root.DeviceInfo.AccessType"
    root.X_AVS_EXT.WAN.GPON.1 {
      Technology.real = "root.DeviceInfo.AccessType"
      Status.real = "root.WANDevice.1.X_GponInterafceConfig.Status"
      RXPower.real = "root.WANDevice.1.X_GponInterafceConfig.RXPower"
      TXPower.real = "root.WANDevice.1.X_GponInterafceConfig.TXPower"
      Temperature.real = "root.WANDevice.1.X_GponInterafceConfig.TransceiverTemperature"
      SupplyVoltage.real = "root.WANDevice.1.X_GponInterafceConfig.SupplyVoltage"
      BiasCurrent.real = "root.WANDevice.1.X_GponInterafceConfig.BiasCurrent"
      Stats.Downstream.Bytes.real = "root.WANDevice.1.X_GponInterafceConfig.Stats.BytesReceived"
      Stats.Downstream.Packets.real = "root.WANDevice.1.X_GponInterafceConfig.Stats.PacketsReceived"
      Stats.Upstream.Bytes.real = "root.WANDevice.1.X_GponInterafceConfig.Stats.BytesSent"
      Stats.Upstream.Packets.real = "root.WANDevice.1.X_GponInterafceConfig.Stats.PacketsSent"
    }

    root.X_AVS_EXT {
      Status.Temperature.real = "root.WANDevice.1.X_GponInterafceConfig.TransceiverTemperature"
      WiFi {
        1 {
          Enable.real = "root.LANDevice.1.WLANConfiguration.1.RadioEnabled"
          SSID.real = "root.LANDevice.1.WLANConfiguration.1.SSID"
          Password.real = "root.LANDevice.1.WLANConfiguration.1.PreSharedKey.1.KeyPassphrase"
          Security.real = "root.LANDevice.1.WLANConfiguration.1.BeaconType"
          Standard.real = "root.LANDevice.1.WLANConfiguration.1.Standard"
          Channel.real = "root.LANDevice.1.WLANConfiguration.1.Channel"
          AutoChannelEnable.real = "root.LANDevice.1.WLANConfiguration.1.AutoChannelEnable"
          SupportedStandards.real = "root.LANDevice.1.WLANConfiguration.1.X_HW_SupportedStandards"
          ChannelWidth.real = "root.LANDevice.1.WLANConfiguration.1.X_HW_HT20"
          WPS {
             Status.real = "root.LANDevice.1.WLANConfiguration.1.WPS.Status"
             Enable.real = "root.LANDevice.1.WLANConfiguration.1.WPS.Enable"
             Pin.real = "root.LANDevice.1.WLANConfiguration.1.WPS.Pin"
          }
          Neighborhood.%i {
            BSSID.real = "root.LANDevice.1.WiFi.Radio.1.X_HW_NeighborAP.%i.BSSID"
            Channel.real = "root.LANDevice.1.WiFi.Radio.1.X_HW_NeighborAP.%i.Channel"
            SSID.real = "root.LANDevice.1.WiFi.Radio.1.X_HW_NeighborAP.%i.SSID"
            Security.real = "root.LANDevice.1.WiFi.Radio.1.X_HW_NeighborAP.%i.Security"
            SignalStrength.real = "root.LANDevice.1.WiFi.Radio.1.X_HW_NeighborAP.%i.RSSI"
            Standard.real = "root.LANDevice.1.WiFi.Radio.1.X_HW_NeighborAP.%i.Standard"
            ChannelBandwidth.real = "root.LANDevice.1.WiFi.Radio.1.X_HW_NeighborAP.%i.ChannelWidth"
          }
          NoiseFloor.real = "root.LANDevice.1.WLANConfiguration.1.AssociatedDevice.%i.X_HW_Noise"
          AssociatedDevice.%i {
            SignalStrength.real = "root.LANDevice.1.WLANConfiguration.1.AssociatedDevice.%i.X_HW_RSSI"
            SignalToNoiseRatio.real = "root.LANDevice.1.WLANConfiguration.1.AssociatedDevice.%i.X_HW_SNR"
            Stats {
              Downstream {
                LastDataRate.real = "root.LANDevice.1.WLANConfiguration.1.AssociatedDevice.%i.X_HW_RxRate"
              }
              Upstream {
                LastDataRate.real = "root.LANDevice.1.WLANConfiguration.1.AssociatedDevice.%i.X_HW_TxRate"
              }
            }
          }
        }
        2 {
          Enable.real = "root.LANDevice.1.WLANConfiguration.5.RadioEnabled"
          SSID.real = "root.LANDevice.1.WLANConfiguration.5.SSID"
          Password.real = "root.LANDevice.1.WLANConfiguration.5.PreSharedKey.1.KeyPassphrase"
          Security.real = "root.LANDevice.1.WLANConfiguration.5.BeaconType"
          Standard.real = "root.LANDevice.1.WLANConfiguration.5.Standard"
          Channel.real = "root.LANDevice.1.WLANConfiguration.5.Channel"
          AutoChannelEnable.real = "root.LANDevice.1.WLANConfiguration.5.AutoChannelEnable"
          SupportedStandards.real = "root.LANDevice.1.WLANConfiguration.5.X_HW_SupportedStandards"
          ChannelWidth.real = "root.LANDevice.1.WLANConfiguration.5.X_HW_HT20"
          WPS {
             Status.real = "root.LANDevice.1.WLANConfiguration.5.WPS.Status"
             Enable.real = "root.LANDevice.1.WLANConfiguration.5.WPS.Enable"
             Pin.real = "root.LANDevice.1.WLANConfiguration.5.WPS.Pin"
          }
          AssociatedDevice.%i {
            MACAddress.real = "root.LANDevice.1.WLANConfiguration.5.AssociatedDevice.%i.AssociatedDeviceMACAddress"
            IPAddress.real = "root.LANDevice.1.WLANConfiguration.5.AssociatedDevice.%i.AssociatedDeviceIPAddress"
            SignalStrength.real = "root.LANDevice.1.WLANConfiguration.5.AssociatedDevice.%i.X_HW_RSSI"
            SignalToNoiseRatio.real = "root.LANDevice.1.WLANConfiguration.5.AssociatedDevice.%i.X_HW_SNR"
            Stats {
              Downstream {
                LastDataRate.real = "root.LANDevice.1.WLANConfiguration.5.AssociatedDevice.%i.X_HW_RxRate"
              }
              Upstream {
                LastDataRate.real = "root.LANDevice.1.WLANConfiguration.5.AssociatedDevice.%i.X_HW_TxRate"
              }
            }
          }
          Name.real = "5 GHz"
          Neighborhood.%i {
            BSSID.real = "root.LANDevice.1.WiFi.Radio.2.X_HW_NeighborAP.%i.BSSID"
            Channel.real = "root.LANDevice.1.WiFi.Radio.2.X_HW_NeighborAP.%i.Channel"
            SSID.real = "root.LANDevice.1.WiFi.Radio.2.X_HW_NeighborAP.%i.SSID"
            Security.real = "root.LANDevice.1.WiFi.Radio.2.X_HW_NeighborAP.%i.Security"
            SignalStrength.real = "root.LANDevice.1.WiFi.Radio.2.X_HW_NeighborAP.%i.RSSI"
            Standard.real = "root.LANDevice.1.WiFi.Radio.2.X_HW_NeighborAP.%i.Standard"
            ChannelBandwidth.real = "root.LANDevice.1.WiFi.Radio.2.X_HW_NeighborAP.%i.ChannelWidth"
          }
        }
      }
    }
  }
}

cwmp.messageTimeout = 180000
cwmp.sessionTimeout = 180000

#fixing that results from wifi scan are mixed (2.4 and 5)

NeighborhoodPatching {
  %force-object-exists = true
  %override-tree = true
  %foreach-x {
    Band.%force-value = "${dm.`LANDevice.1.WiFi.Radio.1.X_HW_NeighborAP`.get(#x).OperatingFrequencyBand.value}"
    BSSID.%force-value = "${dm.`LANDevice.1.WiFi.Radio.1.X_HW_NeighborAP`.get(#x).BSSID.value}"
    Channel.%force-value = "${dm.`LANDevice.1.WiFi.Radio.1.X_HW_NeighborAP`.get(#x).Channel.value}"
    SSID.%force-value = "${dm.`LANDevice.1.WiFi.Radio.1.X_HW_NeighborAP`.get(#x).SSID.value}"
    SignalStrength.%force-value = "${dm.`LANDevice.1.WiFi.Radio.1.X_HW_NeighborAP`.get(#x).SignalStrength.value}"
    Security.%force-value = "${dm.`LANDevice.1.WiFi.Radio.1.X_HW_NeighborAP`.get(#x).SecurityModeEnabled.value}"
    Standard.%force-value = "${dm.`LANDevice.1.WiFi.Radio.1.X_HW_NeighborAP`.get(#x).OperatingStandards.value}"
    OperatingChannelBandwidth.%force-value = "${dm.`LANDevice.1.WiFi.Radio.1.X_HW_NeighborAP`.get(#x).OperatingChannelBandwidth.value}"
  }
}



NeighborhoodPatching24  = ${NeighborhoodPatching}{
  %foreach-x {
    %in = """${dm.`LANDevice.1.WiFi.Radio.1.X_HW_NeighborAP`.any.keys.filter(
                  x => dm.getByPath(x+'Channel').value.toInt <= 13
                 ).map(k => k.keyName)}"""
  }
}

NeighborhoodPatching50 = ${NeighborhoodPatching} {
  %foreach-x {
    %in = """${dm.`LANDevice.1.WiFi.Radio.1.X_HW_NeighborAP`.any.keys.filter(
                  x => dm.getByPath(x+'Channel').value.toInt >= 30
                 ).map(k => k.keyName)}"""
  }
}


virtualPatching.patching.root.X_AVS_EXT.WiFi.%any.AssociatedDevice.%any {
  Stats.Downstream.LastDataRate.%patch-value = "${node.value.toInt * 1000}"
  Stats.Upstream.LastDataRate.%patch-value = "${node.value.toInt * 1000}"
}

virtualPatching.patching {
  root.X_AVS_EXT.WAN {
    Type.%force-value = "GPON"
    GPON.1.Technology.%force-value = "GPON"
  }
  root.X_AVS_EXT.WiFi {
    1 {
      Neighborhood = ${NeighborhoodPatching24}
      # fixing standards - VDM accepts only 'b,g,n' format, but RDM uses '11bgn'
      Standard {
        # patch-value - fixes VDM format. It will display 'b,g,n' - expression is modifying '11bgn' into 'b,g,n'
        %patch-value = "${node.value.drop(2).splitBy('').join(',')}" # b,g,n
        # patch-outgoing-value - sending value from VDM to RDM - fixes RDM format - picking any standard in CC it will start it with '11' - expression is modifying 'b,g,n' into '11bgn'
        %patch-outgoing-value = "${node.value.splitBy(',').join.reverse.concat('11').reverse}" # bgn -> ngb -> ngb11 -> 11bgn
      }
      SupportedStandards {
        %force-value = "b,g,n"
      }
      PossibleSecurities {
        %force-type = "xsd:string"
        %force-value = "NONE,WPA,WPA2,WPA_WPA2"
      }

      ChannelWidth {
        %force-writable = true
      }
    }
    2 {
      Neighborhood =  ${NeighborhoodPatching50}
      Standard {
        # patching to value with format: a,n,ac
        %patch-value = "${if(node.value == '11ac') node.value.drop(2) else if(node.value == '11anac') node.value.drop(2).reverse.drop(2).reverse.splitBy('').join(',').concat(',ac') else node.value.drop(2).splitBy('').join(',')}"
        # patching to value with format: 11anac
        %patch-outgoing-value = "${if(node.value == 'ac') node.value.reverse.concat('11').reverse else node.value.splitBy(',').join.reverse.concat('11').reverse}"
      }
      SupportedStandards {
        %force-value = "a,n,ac"
      }
      PossibleSecurities {
        %force-type = "xsd:string"
        %force-value = "NONE,WPA,WPA2,WPA_WPA2"
      }

      ChannelWidth {
        %force-writable = true
      }
    }
  }
}
