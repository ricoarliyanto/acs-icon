var ldmLanProperties = Map.empty[String, DMKey]
ldm.foreach(ldm.root.X_AVS_EXT.LAN.Port.any(true)) { portKey =>
  ldmLanProperties = ldmLanProperties ++ Map(
    "up.${portKey.name}"-> portKey.Status, // up parameter whether port is up or down
    "duplex.${portKey.name}"-> portKey.DuplexMode, // we will also transform this to boolean
    "currentBitrate.${portKey.name}"-> portKey.CurrentBitRate,
    "errorsSent.${portKey.name}"-> portKey.Stats.Upstream.Errors, // cumulative
    "errorsReceived.${portKey.name}"-> portKey.Stats.Downstream.Errors, // cumulative
    "bytesSent.${portKey.name}"-> portKey.Stats.Upstream.Bytes, // cumulative
    "bytesReceived.${portKey.name}" -> portKey.Stats.Downstream.Bytes, // cumulative
  )
}
val DMLANPortData = ldm.getLabelled(ldmLanProperties, temporaryResults = true, ignoreFaults = true)

// ###### WIFI ###### 2.4, 5 GHz
val band24Instance = sv.cemWiFiVdmWlan24Instance.get.toInt ? 1
val band5Instance = sv.cemWiFiVdmWlan5Instance.get.toInt ? 5

val (DMWiFi24Data, DMWiFi5Data) = Seq(band24Instance, band5Instance).map { (bandInstance) =>
  val wifiKey = dmkey.root.X_AVS_EXT.WiFi(bandInstance)

  val wifiData = ldm.getLabelled(Map(
    "errorsReceived" -> wifiKey.Stats.Downstream.Errors, //cumulative
    "bytesReceived" -> wifiKey.Stats.Downstream.Bytes, //cumulative
    "errorsSent" -> wifiKey.Stats.Upstream.Errors, //cumulative
    "bytesSent" -> wifiKey.Stats.Upstream.Bytes), //cumulative
    temporaryResults = true,
    ignoreFaults = true
  )

  var wifiDataAdditionalProperties = Map.empty[String, DMKey]
  ldm.foreach(wifiKey.query.AssociatedDevice.any(true)) { deviceKey =>
    wifiDataAdditionalProperties = wifiDataAdditionalProperties ++ Map(
      "downlinkRate.${deviceKey.name}" -> deviceKey.Stats.Downstream.LastDataRate, 
      "uplinkRate.${deviceKey.name}" -> deviceKey.Stats.Upstream.LastDataRate,
      "retransmissions.${deviceKey.name}" -> deviceKey.Stats.Downstream.Retransmissions, //cumulative
      "noise.${deviceKey.name}" -> deviceKey.NoiseFloor 
    )
  }

  val wifiAdditionalData = ldm.getLabelled(wifiDataAdditionalProperties, temporaryResults = true, ignoreFaults = true)

  val wifiSumMap = wifiAdditionalData.toSeq.foldLeft(Map.empty[String, Long]){(acc, map) =>
    val (key, value) = map
    val splitKey = key.splitBy(".")
    val paramName = splitKey.get(0).getOr("")
    val currentSum = acc.getOr(paramName, 0)
    val newValue = value.toLong ? 0

    acc.update(paramName, currentSum + newValue)
  }.map{(key, value) => 
    if(key.contains("noise")) (key, (value.toDouble / wifiAdditionalData.filter{(key, value)=> key.splitBy(".").get(0).getOr("").contains("noise")}.size).toLong)
    else if(key.contains("uplinkRate")) (key, (value.toDouble / wifiAdditionalData.filter{(key, value)=> key.splitBy(".").get(0).getOr("").contains("uplinkRate")}.size).toLong)
    else if(key.contains("downlinkRate")) (key, (value.toDouble / wifiAdditionalData.filter{(key, value)=> key.splitBy(".").get(0).getOr("").contains("downlinkRate")}.size).toLong)
    else (key, value)
  }

  wifiSumMap.map((key,value)=>(key->value.toString)) ++ wifiData
} |> { (SeqOfWifiMaps)=> (SeqOfWifiMaps.get(0).getOr(Map.empty[String,String]), SeqOfWifiMaps.get(1).getOr(Map.empty[String,String]))}

