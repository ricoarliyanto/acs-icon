lazy val kbUnit = math.pow(1024,1)
lazy val mbUnit = math.pow(1024,2)
lazy val gbUnit = math.pow(1024,3)

// ##### LAN #####
val transformedLanProperties = DMLANPortData.toSeq.foldRight(Map.empty[String, Json]){(lanData, acc)=>
  val (k, value) = lanData
  val keyPropertyName = k.splitAtSep(".")._1
  if(keyPropertyName == "up"){
    if (value.uncapitalize == "up"){
      acc + (keyPropertyName ->true.encodeJson)
    }else if(acc.get("up").exists(_.isBoolean)){
      acc + (keyPropertyName -> false.encodeJson)
    }else acc
  }else if(keyPropertyName == "duplex"){
    if (value.uncapitalize == "full" || value.uncapitalize == "auto"){
      acc + (keyPropertyName->true.encodeJson)
    }else if(acc.get("duplex").exists(_.isBoolean)){
      acc + (keyPropertyName->false.encodeJson)
    } else acc
  }else if(keyPropertyName == "currentBitrate"){
      acc + (keyPropertyName -> math.max(value.toLong ? 0, acc.getOr(keyPropertyName, 0.encodeJson).asLong).encodeJson)
  }else if(keyPropertyName.contains("bytes") || keyPropertyName.contains("errors")){
    val previousValue = acc.getOr(keyPropertyName, 0.encodeJson).decodeAs[Long]
    acc + (keyPropertyName->(previousValue + (value.toLong ? 0)).encodeJson) 
  }
  else{
    acc
  }  
}.filter((_,v) => "$v" != "0")
val (ethernetDataReceived, ethernetDataSent) = Seq(transformedLanProperties).flatMap(data => Seq("bytesReceived", "bytesSent").map(key=> data.getOr(key, 0.encodeJson))).map{value =>
  val bytes = value.decodeAs[Long].toDouble
  val humanReadableBytes:String = {if (bytes < kbUnit) {
    (bytes, "bytes")
  } else if (bytes < mbUnit) {
      (bytes / kbUnit, "KB")
    } else if (bytes < gbUnit) {
      (bytes / mbUnit, "MB")
    } else {
      (bytes / gbUnit, "GB")
    }} |> {(pair:(Double,String)) =>
    val (value, unit) = pair
    // Format to 2 decimal places by rounding manually
    "${(math.round(value*100).toDouble/100).toString |> {value => if(value.endsWith(".0")) value.dropRight(2) else value}} $unit"
  }
  humanReadableBytes
} |> {array => (array(0), array(1))}
val ethernetJson = transformedLanProperties.encodeJson
