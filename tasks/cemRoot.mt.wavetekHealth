var sessionMonitoringDataDBCursor = http.localRest("monitoringData/samples/${SESSION_MONITORING_NAME.urlEncodeUTF8}/${device.id}", 
  uriParameters = Seq("fromDate" -> "${DATE_NOW - MONITORING_AMOUNT_OF_DAYS}", "toDate" -> "$DATE_NOW", "exactId" -> "true")
).tryAndFold(
  e => {
    fail("ERROR", "Failed to get monitoring data: ${e.toString.replace("\n", "")}")
  },
  response => {
    if (response.isError) {
      fail("ERROR", "Failed to get monitoring data: ${response.body.error.asString}")
    }
    else {
      val monitoringDataDBCursor = response.body.decodeAs[Int]
      log.debug("Session monitoring data is in cursor: $monitoringDataDBCursor")
      monitoringDataDBCursor.opt
    }
  }
)

var sessionMonitoringData = Seq.empty[Json]

do {
  val sessionMonitoringDataSamples = http.localRest("monitoringData/moreSamples", 
    uriParameters = Seq("cursor" -> "${sessionMonitoringDataDBCursor.get}", "count" -> "3000")
  ).tryAndFold(
    e => {
      fail("ERROR", "Failed to get monitoring data: ${e.toString.replace("\n", "")}")
    },
    response => {
      if (response.isError) {
        fail("ERROR", "Failed to get monitoring data: ${response.body.error.asString}")
      }
      else {
        val responseObject = response.body.decodeAs[Map[String, Json]]
        sessionMonitoringDataDBCursor = if (responseObject.get("nextCursor").get.isNull) {
          Opt.empty[Int]
        } else {
          responseObject.get("nextCursor").get.decodeAs[Int].opt
        }
        val monitoringData = responseObject.get("batch").getOr(fail("ERROR", "JSON is missing batch"))
        monitoringData.asArray
      }
    }
  )
  sessionMonitoringData = sessionMonitoringData.concat(sessionMonitoringDataSamples)
} while (sessionMonitoringDataDBCursor.isDefined)

var arrangedRebootSwitch = false
var arrangedFactoryResetSwitch = false

val (scheduledRebootsJson, unscheduledRebootsJson)
  = sessionMonitoringData.foldLeft(Map("scheduledReboots" -> Seq.empty[String], "unscheduledReboots" -> Seq.empty[String]))((acc, dataPoint) => {
    val sessionTypes = dataPoint.numericResources.asObject.keySet
    if (sessionTypes.contains("ArrangedReboot")){
      arrangedRebootSwitch = true
      acc
    } else if (sessionTypes.contains("ArrangedFactoryReset")) {
      arrangedFactoryResetSwitch = true
      acc
    } else if (sessionTypes.containsAll(Set("FactoryReset", "Reboot"))) {
      if (arrangedFactoryResetSwitch) {
        arrangedFactoryResetSwitch = false
        // Scheduled reboots are reboots triggered by UMP, for example by running the "Restart device" recommnedation.
        // Currently klAdrI doesn't differentiate between scheduled and unscheduled reboots, meaning that
        // a scheduled reboot would negatively impact the `Connection Stability` health score as much as an
        // unscheduled reboot. That would mean that the "Restart device" CEM recommendation would be doing
        // the opposite of its intended goal, which is improving the device's health score.
        acc/*.update("scheduledReboots", acc.get("scheduledReboots").get.append(dataPoint.date.asString))*/
      } else {        
        acc.update("unscheduledReboots", acc.get("unscheduledReboots").get.append(dataPoint.date.asString))
      }
    } else if (sessionTypes.contains("Reboot")) {
      if (arrangedRebootSwitch) {
        arrangedRebootSwitch = false
        acc/*.update("scheduledReboots", acc.get("scheduledReboots").get.append(dataPoint.date.asString))*/
      } else {        
        acc.update("unscheduledReboots", acc.get("unscheduledReboots").get.append(dataPoint.date.asString))
      }
    } else {
      acc
    }
  }) |> {dataMap => {
    (dataMap.apply("scheduledReboots").encodeJson, dataMap.apply("unscheduledReboots").encodeJson)
  }}

