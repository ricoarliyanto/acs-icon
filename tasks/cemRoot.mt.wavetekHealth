    optValue.flatMap(_.toLong.tryAsOpt).nonEmpty
  ).map(
    (key, optValue) => (key, optValue.get.toLong.encodeJson)
  ).encodeJson

  // Filter WiFi 2.4 GHz data
  val wifi24Json = Map(
    "errorsSent" -> "Wi-Fi 2.4GHz Errors Sent",
    "errorsReceived" -> "Wi-Fi 2.4GHz Errors Received",
    "bytesSent" -> "Wi-Fi 2.4GHz Bytes Sent",
    "bytesReceived" -> "Wi-Fi 2.4GHz Bytes Received",
    "normalizedSignalQuality" -> "Wi-Fi Score for 2.4GHz",
    "retransmissions" -> "Wi-Fi 2.4GHz Avg Retransmissions",
    "uplinkRate" -> "Wi-Fi 2.4GHz Avg Upstream Last DataRate",
    "downlinkRate" -> "Wi-Fi 2.4GHz Avg Downstream Last DataRate",
    "noise" -> "Wi-Fi 2.4GHz Avg Noise",
    "channelRank" -> "Wi-Fi 2.4GHz ChannelRank"
  ).map((key, param) => (key, numericalData.get(param))).filter((key,optValue)=>
    optValue.flatMap(_.toLong.tryAsOpt).nonEmpty
  ).map(
    (key, optValue) => (key, optValue.get.toLong.encodeJson)
  ).encodeJson

  // Filter WiFi 5 GHz data
  val wifi5Json = Map(
    "errorsSent" -> "Wi-Fi 5GHz Errors Sent",
    "errorsReceived" -> "Wi-Fi 5GHz Errors Received",
    "bytesSent" -> "Wi-Fi 5GHz Bytes Sent",
    "bytesReceived" -> "Wi-Fi 5GHz Bytes Received",
    "normalizedSignalQuality" -> "Wi-Fi Score for 5GHz",
    "retransmissions" -> "Wi-Fi 5GHz Avg Retransmissions",
    "uplinkRate" -> "Wi-Fi 5GHz Avg Upstream Last DataRate",
    "downlinkRate" -> "Wi-Fi 5GHz Avg Downstream Last DataRate",
    "noise" -> "Wi-Fi 5GHz Avg Noise",
    "channelRank" -> "Wi-Fi 5GHz ChannelRank"
  ).map((key, param) => (key, numericalData.get(param))).filter((key,optValue)=>
    optValue.flatMap(_.toLong.tryAsOpt).nonEmpty
  ).map(
    (key, optValue) => (key, optValue.get.toLong.encodeJson)
  ).encodeJson

  // Filter WAN data
  val wanJsonDsl = Map(
    // Required Fields
    "technology" -> DSL_TECHNOLOGY.encodeJson
  ).merge(
    Map(
      "upstreamAttenuation" -> "WAN DSL Upstream Attenuation",
      "downstreamAttenuation" -> "WAN DSL Downstream Attenuation",
      "upstreamCrcErrors" -> "WAN DSL Upstream CRC Errors",
      "downstreamCrcErrors" -> "WAN DSL Downstream CRC Errors",
      "linkRetrain" -> "WAN DSL Link Retrain",
      "upstreamSnr" -> "WAN DSL Upstream SNR",
      "downstreamSnr" -> "WAN DSL Downstream SNR",
      "upstreamMaximalRate" -> "WAN DSL Upstream Maximal Rate",
      "downstreamMaximalRate" -> "WAN DSL Downstream Maximal Rate"
  ).map((key, param) => (key, numericalData.get(param))).filter((key,optValue)=>
      optValue.flatMap(_.toLong.tryAsOpt).nonEmpty
    ).map(
      (key, optValue) => (key, optValue.get.toLong.encodeJson)
    )
  ).encodeJson
	
  Map(
  "timestamp" -> timestamp.encodeJson,
    "ethernet" -> ethernetJson,
    "hardware" -> hardwareJson,
    "wifi24" -> wifi24Json,
    "wifi5" -> wifi5Json,
    "wan" -> wanJsonDsl
  ).encodeJson
}.concat(additionalParameters).encodeJson

log.debug(parametersList)

val kladriInputParams = Map(
  "now" -> "$DATE_NOW".encodeJson,
  "identity" -> device.id.encodeJson,
  "samplingInterval" -> SAMPLING_INTERVAL.encodeJson,
  "scheduledReboots" -> scheduledRebootsJson,
  "unscheduledReboots" -> unscheduledRebootsJson,
  "parameters" -> parametersList
).encodeJson
log.debug(kladriInputParams)

log.debug(HEALTH_SCORE_FROM_EXTERNAL_SYSTEMS)
// we're fetching health score from external system or we're using random values if external system is not defined for now
val healthScoreOutputJson = if(HEALTH_SCORE_FROM_EXTERNAL_SYSTEMS){
  val healthScoreOutput = http.rest(
    HEALTH_SCORE_ENDPOINT.get,
    tlsHostnameVerification = false,
    credentials = HEALTH_SCORE_CREDENTIALS,
    method = "POST",
    content = kladriInputParams
  ).tryAndFold(
    e=> {
      fail("ERROR", msg = e.toString)
    },
    res=>res.body
  )
  healthScoreOutput
}else{
  Seq.range(0,7).map(_=>(math.random()*100).toInt.encodeJson) |> { score =>
    Map(
      "totalScore" ->  score.get(0),
      "subscores" -> Map(
      	"internetConnection" ->  score.get(1),
        "wiFi" ->  score.get(2),
        "ethernet" ->  score.get(3),
        "accessNetworkTechnology" ->  score.get(4),
        "hardwarePerformance" ->  score.get(5),
        "connectionStability" ->  score.get(6)
      ).encodeJson
    ).encodeJson
  }
}

device.property.cemHealthScore.set(healthScoreOutputJson.toString)
log.debug(healthScoreOutputJson)

var (healthScoreTotal:Int, healthScoreSubscores: Seq[(String, Int)]) = 
healthScoreOutputJson.decodeAs[Json].asObject |> {
  obj => (obj.get("subscores").get.decodeAs[Map[String, Json]].toSeq ? Seq.empty).prepend(("totalScore",obj.get("totalScore").get)).map(
    (key,value) => (key, if(value.isNull) 100 else value.asInt)
  )
} |> { scoreSeq => (scoreSeq.head._2, scoreSeq.drop(1)) }

device.property.cemHealthScoreTotalScore.set(healthScoreTotal.toString)
healthScoreSubscores.foreach{(key, value)=>
  device.property.selectDynamic("cemHealthScoreSubscores${key.capitalize}").set(value.toString)
}

val healthScoreKPIGroup =
if (healthScoreTotal <= 30) {
  HEALTH_SCORE_KPI_GROUPS.poor
} else if (healthScoreTotal <= 60) {
  HEALTH_SCORE_KPI_GROUPS.fair
} else {
  HEALTH_SCORE_KPI_GROUPS.good
}

if(device.directGroups.find(directGroup=>directGroup == healthScoreKPIGroup).isEmpty){
  device.leaveGroup(HEALTH_SCORE_KPI_GROUPS, leaveSubgroups = true)
  device.joinGroup(healthScoreKPIGroup)
}

device.property.cemHealthTimeOfLastRun.set(DATE_NOW.millis.toString) 