<config>
  <store target="id" value="${task.properties('id').toInt-1}" />
  <store target="cliCommand" value="/ip pool remove ${#id}" />
  <cli protocol="${sv.protocol}">
    <command cmd="${#cliCommand}" />
    <out target="output" />
  </cli>
  <if expr="${#output.contains('no such')}">
    <finish status="ERROR" message="Error while executing the task ${#output}" />
  </if>
  <getParameters key="Device.X_AVS_EXT.DHCP.Pool." />
</config>