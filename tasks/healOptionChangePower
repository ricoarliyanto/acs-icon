<config>
  <set key="Root.X_AVS_EXT.WiFi.${#radio}.Power" value="${#power}" />
  <log message="Power changed to ${#power} on radio ${#radio} by Heal Action" />
  <store target="smartWifiDisableReason" value="Manual change of power" />
  <task template="smartWifiDisable">
    <input var="smartWifiDisableReason" />
  </task>
</config>
