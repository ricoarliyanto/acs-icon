<config>
  <get key="InternetGatewayDevice.DeviceInfo.UpTime" output="upTime" ignoreFaults="true" />
  <get key="${sv.activeWan}.ConnectionStatus" output="ConnectionStatus" ignoreFaults="true" />
  <get key="${sv.activePpp}.ExternalIPAddress" output="ExternalIPAddress" ignoreFaults="true" />
  <get key="${sv.activeWan}.DNSServers" output="DNSServers" ignoreFaults="true" />
  <get key="${sv.activeWan}.LastConnectionError" output="LastConnectionError" ignoreFaults="true" />
  <get key="${sv.activeWan}.MaxMTUSize" output="MaxMTUSize" ignoreFaults="true" />
  <get key="${sv.activeWan}.MACAddress" output="cpeActiveTr069Mac" ignoreFaults="true" />
  <get key="${sv.activePpp}.MACAddress" output="cpeActiveWanMac" ignoreFaults="true" />
  <get key="${sv.activePpp}.Username" output="cpePppUsername" ignoreFaults="true" />
  <store type="devProp" target="cpeInternetWanConnectionStatus" value="${#ConnectionStatus}" />
  <store type="devProp" target="IPService" value="${#ExternalIPAddress}" />
  <store type="devProp" target="cpeInternetWanDNSServers" value="${#DNSServers}" />
  <store type="devProp" target="cpeInternetWanLastConnectionError" value="${#LastConnectionError}" />
  <store type="devProp" target="cpeInternetWanMaxMTUSize" value="${#MaxMTUSize}" />
  <store type="devProp" target="cpeActiveWanMac" value="${#cpeActiveWanMac}" />
  <store type="devProp" target="cpeActiveTr069Mac" value="${#cpeActiveTr069Mac}" />
  <store type="devProp" target="cpePppUsername" value="${#cpePppUsername}" />
  <if expr="${device.manufacturer.toLowerCaseEnglish.contains('huawei')}">
    <get key="${device.rootObject}.X_AVS_EXT.Resources.CPUUsed" output="cpeCpuUsed" ignoreFaults="true" />
    <get key="${device.rootObject}.X_AVS_EXT.Resources.RAMUsedPercent" output="cpeMemUsed" ignoreFaults="true" />
    <get key="${device.rootObject}.X_AVS_EXT.Diagnostics.Download.Result.TotalBytesReceived" output="cpeDownload" ignoreFaults="true" />
    <get key="${device.rootObject}.X_AVS_EXT.Diagnostics.Upload.Result.TotalBytesSent" output="cpeUpload" ignoreFaults="true" />
    <get key="${device.rootObject}.X_AVS_EXT.WiFi.1.SSID" output="cpeActiveSSID2" ignoreFaults="true" />
    <get key="${device.rootObject}.X_AVS_EXT.WiFi.1.AutoChannelEnable" output="cpeAutoChannel" ignoreFaults="true" />
    <get key="${device.rootObject}.X_AVS_EXT.WAN.Stats.Downstream.Bytes" output="cpeTotalByte" ignoreFaults="true" />
    <get key="${device.rootObject}.X_AVS_EXT.WAN.GPON.1.RXPower" output="cpeRXPower" ignoreFaults="true" />
    <get key="${device.rootObject}.X_AVS_EXT.WAN.GPON.1.TXPower" output="cpeTXPower" ignoreFaults="true" />
    <get key="${sv.activePpp}.X_HW_VLAN" output="cpeInternetWanVLANID" ignoreFaults="true" />
    <get key="${sv.activePpp}.X_HW_SERVICELIST" output="cpeInternetWanServiceList" ignoreFaults="true" />
    <get key="${sv.activePpp}.X_HW_IPv6.IPv6Address" output="cpeInternetIpv6Address" ignoreFaults="true" />
    <get key="${sv.activePpp}.X_HW_IPv6.IPv6Prefix" output="cpeInternetIpv6Prefix" ignoreFaults="true" />
    <if expr="${device.productClass == 'EG8141A5'}">
      <!-- Specific mappings for EG8141A5 using WANConnectionDevice.2 -->
      <get key="InternetGatewayDevice.WANDevice.1.WANConnectionDevice.2.WANPPPConnection.1.ExternalIPAddress" output="ExternalIPAddress" ignoreFaults="true" />
      <get key="InternetGatewayDevice.WANDevice.1.WANConnectionDevice.2.WANPPPConnection.1.MACAddress" output="cpeActiveWanMac" ignoreFaults="true" />
      <get key="InternetGatewayDevice.WANDevice.1.WANConnectionDevice.2.WANPPPConnection.1.X_HW_VLAN" output="VLAN_Service" ignoreFaults="true" />
      <get key="InternetGatewayDevice.WANDevice.1.WANConnectionDevice.2.WANPPPConnection.1.Username" output="cpePppUsername" ignoreFaults="true" />
      <get key="InternetGatewayDevice.DeviceInfo.X_HW_CpuUsed" output="cpeCpuUsed" ignoreFaults="true" />
      <get key="InternetGatewayDevice.DeviceInfo.X_HW_MemUsed" output="cpeMemUsed" ignoreFaults="true" />

      <store type="devProp" target="IPService" value="${#ExternalIPAddress}" />
      <store type="devProp" target="cpeActiveWanMac" value="${#cpeActiveWanMac}" />
      <store type="devProp" target="VLAN_Service" value="${#VLAN_Service}" />
      <store type="devProp" target="cpePppUsername" value="${#cpePppUsername}" />
    </if>
    <store type="devProp" target="cpeCpuUsed" value="${#cpeCpuUsed}" />
    <store type="devProp" target="cpeMemUsed" value="${#cpeMemUsed}" />
    <store type="devProp" target="cpeDownload" value="${#cpeDownload}" />
    <store type="devProp" target="cpeUpload" value="${#cpeUpload}" />
    <store type="devProp" target="cpeActiveSSID2" value="${#cpeActiveSSID2}" />
    <store type="devProp" target="cpeAutoChannel" value="${#cpeAutoChannel}" />
    <store type="devProp" target="cpeTotalByte" value="${#cpeTotalByte}" />
    <store type="devProp" target="cpeRXPower" value="${#cpeRXPower}" />
    <store type="devProp" target="cpeTXPower" value="${#cpeTXPower}" />
    <store type="devProp" target="VLAN_Service" value="${#cpeInternetWanVLANID}" />
    <store type="devProp" target="cpeInternetWanServiceList" value="${#cpeInternetWanServiceList}" />
    <store type="devProp" target="cpeInternetIpv6Address" value="${#cpeInternetIpv6Address}" />
    <store type="devProp" target="cpeInternetIpv6Prefix" value="${#cpeInternetIpv6Prefix}" />
  </if>
  <if expr="${device.manufacturer.toLowerCaseEnglish.contains('hsgq')}">
    <get key="${device.rootObject}.X_AVS_EXT.Resources.CPUUsed" output="cpeCpuUsed" ignoreFaults="true" />
    <get key="${device.rootObject}.X_AVS_EXT.Resources.RAMUsedPercent" output="cpeMemUsed" ignoreFaults="true" />
    <get key="${device.rootObject}.X_AVS_EXT.Diagnostics.Download.Result.TotalBytesReceived" output="cpeDownload" ignoreFaults="true" />
    <get key="${device.rootObject}.X_AVS_EXT.Diagnostics.Upload.Result.TotalBytesSent" output="cpeUpload" ignoreFaults="true" />
    <get key="${device.rootObject}.X_AVS_EXT.WiFi.1.SSID" output="cpeActiveSSID2" ignoreFaults="true" />
    <get key="${device.rootObject}.X_AVS_EXT.WiFi.1.AutoChannelEnable" output="cpeAutoChannel" ignoreFaults="true" />
    <get key="${device.rootObject}.X_AVS_EXT.WAN.Stats.Downstream.Bytes" output="cpeTotalByte" ignoreFaults="true" />
    <get key="${device.rootObject}.X_AVS_EXT.WAN.GPON.1.RXPower" output="cpeRXPower" ignoreFaults="true" />
    <get key="${device.rootObject}.X_AVS_EXT.WAN.GPON.1.TXPower" output="cpeTXPower" ignoreFaults="true" />
    <store type="devProp" target="cpeCpuUsed" value="${#cpeCpuUsed}" />
    <store type="devProp" target="cpeMemUsed" value="${#cpeMemUsed}" />
    <store type="devProp" target="cpeDownload" value="${#cpeDownload}" />
    <store type="devProp" target="cpeUpload" value="${#cpeUpload}" />
    <store type="devProp" target="cpeActiveSSID2" value="${#cpeActiveSSID2}" />
    <store type="devProp" target="cpeAutoChannel" value="${#cpeAutoChannel}" />
    <store type="devProp" target="cpeTotalByte" value="${#cpeTotalByte}" />
    <store type="devProp" target="cpeRXPower" value="${#cpeRXPower}" />
    <store type="devProp" target="cpeTXPower" value="${#cpeTXPower}" />
  </if>
  <if expr="${device.manufacturer.toLowerCaseEnglish.contains('zte')}">
    <get key="InternetGatewayDevice.DeviceInfo.X_ZTE_CpuUsage" output="cpeCpuUsed" ignoreFaults="true" />
    <get key="InternetGatewayDevice.DeviceInfo.X_ZTE_MemUsage" output="cpeMemUsed" ignoreFaults="true" />
    <get key="InternetGatewayDevice.DownloadDiagnostics.TotalBytesReceived" output="cpeDownload" ignoreFaults="true" />
    <get key="InternetGatewayDevice.UploadDiagnostics.TotalBytesSent" output="cpeUpload" ignoreFaults="true" />
    <get key="InternetGatewayDevice.LANDevice.1.WLANConfiguration.1.SSID" output="cpeActiveSSID2" ignoreFaults="true" />
    <get key="InternetGatewayDevice.LANDevice.1.WLANConfiguration.1.AutoChannelEnable" output="cpeAutoChannel" ignoreFaults="true" />
    <get key="InternetGatewayDevice.WANDevice.1.WANCommonInterfaceConfig.TotalBytesReceived" output="cpeTotalByte" ignoreFaults="true" />
    <get key="InternetGatewayDevice.WANDevice.1.WANConnectionDevice.1.WANPPPConnection.1.X_ZTE_RXPwr" output="cpeRXPower" ignoreFaults="true" />
    <get key="InternetGatewayDevice.WANDevice.1.WANConnectionDevice.1.WANPPPConnection.1.X_ZTE_TXPwr" output="cpeTXPower" ignoreFaults="true" />
    <get key="${sv.activePpp}.X_ZTE_VLANID" output="cpeInternetWanVLANID" ignoreFaults="true" />
    <store type="devProp" target="cpeCpuUsed" value="${#cpeCpuUsed}" />
    <store type="devProp" target="cpeMemUsed" value="${#cpeMemUsed}" />
    <store type="devProp" target="cpeDownload" value="${#cpeDownload}" />
    <store type="devProp" target="cpeUpload" value="${#cpeUpload}" />
    <store type="devProp" target="cpeActiveSSID2" value="${#cpeActiveSSID2}" />
    <store type="devProp" target="cpeAutoChannel" value="${#cpeAutoChannel}" />
    <store type="devProp" target="cpeTotalByte" value="${#cpeTotalByte}" />
    <store type="devProp" target="cpeRXPower" value="${#cpeRXPower}" />
    <store type="devProp" target="cpeTXPower" value="${#cpeTXPower}" />
    <store type="devProp" target="VLAN_Service" value="${#cpeInternetWanVLANID}" />
  </if>
  <if expr="${device.manufacturer.toLowerCaseEnglish.contains('fiberhome')}">
    <get key="InternetGatewayDevice.DeviceInfo.X_FH_CpuUsage" output="cpeCpuUsed" ignoreFaults="true" />
    <get key="InternetGatewayDevice.DeviceInfo.X_FH_MemUsage" output="cpeMemUsed" ignoreFaults="true" />
    <if expr="${device.productClass == 'HG6145D2'}">
      <get key="InternetGatewayDevice.X_AVS_EXT.Resources.CPUUsed" output="cpeCpuUsed" ignoreFaults="true" />
      <get key="InternetGatewayDevice.X_AVS_EXT.Resources.RAMUsedPercent" output="cpeMemUsed" ignoreFaults="true" />
    </if>
    <if expr="${device.productClass == 'HG6045D1'}">
      <get key="InternetGatewayDevice.DeviceInfo.ProcessStatus.CPUUsage" output="cpeCpuUsed" ignoreFaults="true" />
      <get key="InternetGatewayDevice.DeviceInfo.MemoryStatus.MemoryUsage" output="cpeMemUsed" ignoreFaults="true" />
    </if>
    <get key="InternetGatewayDevice.DownloadDiagnostics.TotalBytesReceived" output="cpeDownload" ignoreFaults="true" />
    <get key="InternetGatewayDevice.UploadDiagnostics.TotalBytesSent" output="cpeUpload" ignoreFaults="true" />
    <get key="InternetGatewayDevice.LANDevice.1.WLANConfiguration.1.SSID" output="cpeActiveSSID2" ignoreFaults="true" />
    <get key="InternetGatewayDevice.LANDevice.1.WLANConfiguration.1.AutoChannelEnable" output="cpeAutoChannel" ignoreFaults="true" />
    <get key="InternetGatewayDevice.WANDevice.1.WANCommonInterfaceConfig.TotalBytesReceived" output="cpeTotalByte" ignoreFaults="true" />
    <get key="InternetGatewayDevice.WANDevice.1.X_FH_GponRxPower" output="cpeRXPower" ignoreFaults="true" />
    <get key="InternetGatewayDevice.WANDevice.1.X_FH_GponTxPower" output="cpeTXPower" ignoreFaults="true" />
    <get key="${sv.activePpp}.X_FH_VLANID" output="cpeInternetWanVLANID" ignoreFaults="true" />
    <if expr="${device.productClass == 'HG6145D2'}">
      <get key="${sv.activePpp}.VLANID" output="cpeInternetWanVLANID" ignoreFaults="true" />
    </if>
    <if expr="${device.productClass == 'HG6045D1'}">
      <get key="InternetGatewayDevice.WANDevice.1.WANConnectionDevice.1.WANPPPConnection.1.VLANID" output="cpeInternetWanVLANID" ignoreFaults="true" />
    </if>
    <store type="devProp" target="cpeCpuUsed" value="${#cpeCpuUsed}" />
    <store type="devProp" target="cpeMemUsed" value="${#cpeMemUsed}" />
    <store type="devProp" target="cpeDownload" value="${#cpeDownload}" />
    <store type="devProp" target="cpeUpload" value="${#cpeUpload}" />
    <store type="devProp" target="cpeActiveSSID2" value="${#cpeActiveSSID2}" />
    <store type="devProp" target="cpeAutoChannel" value="${#cpeAutoChannel}" />
    <store type="devProp" target="cpeTotalByte" value="${#cpeTotalByte}" />
    <store type="devProp" target="cpeRXPower" value="${#cpeRXPower}" />
    <store type="devProp" target="cpeTXPower" value="${#cpeTXPower}" />
    <store type="devProp" target="VLAN_Service" value="${#cpeInternetWanVLANID}" />
  </if>
  <if expr="${device.manufacturer.toLowerCaseEnglish.contains('raisecom')}">
    <get key="InternetGatewayDevice.DeviceInfo.X_RAISECOM_CpuUsage" output="cpeCpuUsed" ignoreFaults="true" />
    <get key="InternetGatewayDevice.DeviceInfo.X_RAISECOM_MemUsage" output="cpeMemUsed" ignoreFaults="true" />
    <get key="InternetGatewayDevice.DownloadDiagnostics.TotalBytesReceived" output="cpeDownload" ignoreFaults="true" />
    <get key="InternetGatewayDevice.UploadDiagnostics.TotalBytesSent" output="cpeUpload" ignoreFaults="true" />
    <get key="InternetGatewayDevice.LANDevice.1.WLANConfiguration.1.SSID" output="cpeActiveSSID2" ignoreFaults="true" />
    <get key="InternetGatewayDevice.LANDevice.1.WLANConfiguration.1.AutoChannelEnable" output="cpeAutoChannel" ignoreFaults="true" />
    <get key="InternetGatewayDevice.WANDevice.1.WANCommonInterfaceConfig.TotalBytesReceived" output="cpeTotalByte" ignoreFaults="true" />
    <get key="InternetGatewayDevice.WANDevice.1.PON.X_RT_RxPower" output="cpeRXPower" ignoreFaults="true" />
    <get key="InternetGatewayDevice.WANDevice.1.PON.X_RT_TxPower" output="cpeTXPower" ignoreFaults="true" />
    <store type="devProp" target="cpeCpuUsed" value="${#cpeCpuUsed}" />
    <store type="devProp" target="cpeMemUsed" value="${#cpeMemUsed}" />
    <store type="devProp" target="cpeDownload" value="${#cpeDownload}" />
    <store type="devProp" target="cpeUpload" value="${#cpeUpload}" />
    <store type="devProp" target="cpeActiveSSID2" value="${#cpeActiveSSID2}" />
    <store type="devProp" target="cpeAutoChannel" value="${#cpeAutoChannel}" />
    <store type="devProp" target="cpeTotalByte" value="${#cpeTotalByte}" />
    <store type="devProp" target="cpeRXPower" value="${#cpeRXPower}" />
    <store type="devProp" target="cpeTXPower" value="${#cpeTXPower}" />
  </if>
  <if expr="${device.manufacturer.toLowerCaseEnglish.contains('bdcom') || device.manufacturer.toLowerCaseEnglish.contains('datacom')}">
    <get key="InternetGatewayDevice.LANDevice.1.WLANConfiguration.1.SSID" output="cpeActiveSSID2" ignoreFaults="true" />
    <get key="InternetGatewayDevice.WANDevice.1.X_CT-COM_GponInterfaceConfig.TransceiverTemperature" output="TransceiverTemperature" ignoreFaults="true" />
    <get key="InternetGatewayDevice.X_AVS_EXT.Diagnostics.Download.Result.TotalBytesReceived" output="cpeDownload" ignoreFaults="true" />
    <get key="InternetGatewayDevice.WANDevice.1.X_CT-COM_GponInterfaceConfig.RXPower" output="cpeRXPower" ignoreFaults="true" />
    <get key="InternetGatewayDevice.WANDevice.1.X_CT-COM_GponInterfaceConfig.TXPower" output="cpeTXPower" ignoreFaults="true" />
    <get key="InternetGatewayDevice.X_AVS_EXT.Resources.RAMUsedPercent" output="cpeMemUsed" ignoreFaults="true" />
    <get key="InternetGatewayDevice.X_AVS_EXT.Resources.CPUUsed" output="cpeCpuUsed" ignoreFaults="true" />
    <store type="devProp" target="cpeActiveSSID2" value="${#cpeActiveSSID2}" />
    <store type="devProp" target="TransceiverTemperature" value="${#TransceiverTemperature}" />
    <store type="devProp" target="cpeDownload" value="${#cpeDownload}" />
    <store type="devProp" target="cpeRXPower" value="${#cpeRXPower}" />
    <store type="devProp" target="cpeTXPower" value="${#cpeTXPower}" />
    <store type="devProp" target="cpeMemUsed" value="${#cpeMemUsed}" />
    <store type="devProp" target="cpeCpuUsed" value="${#cpeCpuUsed}" />
  </if>
  <if expr="${device.productClass == 'GP1704-4GV2'}">
    <get key="InternetGatewayDevice.X_AVS_EXT.Resources.CPUUsed" output="cpeCpuUsed" ignoreFaults="true" />
    <get key="InternetGatewayDevice.X_AVS_EXT.Resources.RAMUsedPercent" output="cpeMemUsed" ignoreFaults="true" />
    <get key="InternetGatewayDevice.X_AVS_EXT.Diagnostics.Download.Result.TotalBytesReceived" output="cpeDownload" ignoreFaults="true" />
    <get key="InternetGatewayDevice.X_AVS_EXT.Diagnostics.Upload.Result.TotalBytesSent" output="cpeUpload" ignoreFaults="true" />
    <get key="InternetGatewayDevice.X_AVS_EXT.WiFi.1.SSID" output="cpeActiveSSID2" ignoreFaults="true" />
    <get key="InternetGatewayDevice.X_AVS_EXT.WiFi.1.AutoChannelEnable" output="cpeAutoChannel" ignoreFaults="true" />
    <get key="InternetGatewayDevice.X_AVS_EXT.WAN.Stats.Downstream.Bytes" output="cpeTotalByte" ignoreFaults="true" />
    <get key="InternetGatewayDevice.X_AVS_EXT.WAN.GPON.1.RXPower" output="cpeRXPower" ignoreFaults="true" />
    <get key="InternetGatewayDevice.X_AVS_EXT.WAN.GPON.1.TXPower" output="cpeTXPower" ignoreFaults="true" />
