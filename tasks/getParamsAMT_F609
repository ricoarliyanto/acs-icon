    </if>
    <if expr="${#PppSvc1 != null and (#PppSvc1.toLowerCaseEnglish.contains('tr069') or #PppSvc1.toLowerCaseEnglish.contains('tr'))}">
        <store type="devProp" target="cpeActiveTr069Mac" value="${#PppMac1}" />
