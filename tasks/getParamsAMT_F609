    <!-- EVALUATE WCD.1 -->
    <if expr="${#PppSvc1 != null and (#PppSvc1.toLowerCaseEnglish.contains('inet') or #PppSvc1.toLowerCaseEnglish.contains('internet'))}">
        <store type="devProp" target="cpeInternetWanExternalIPAddress" value="${#PppIP1}" />
        <store type="devProp" target="cpeInternetWanVLANID" value="${#PppVlan1}" />
