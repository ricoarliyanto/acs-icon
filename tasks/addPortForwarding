<config>
  <log message="Check DM1" />
  <if expr="${device.directGroups.contains('root.dataModel.cwmp.InternetGatewayDevice1')}">
    <find query="${root.get(string.removeTRRoot(sv.activeWan)).moveUp.any}" in="true">
      <add parentKey="PortMapping." output="instance" />
      <finish message="New port mapping for DM1 added. Instance number ${#instance}" />
    </find>
  </if>
  <log message="Check DM2" />
  <if expr="${device.directGroups.contains('root.dataModel.cwmp.Device2')}">
    <find query="${root.NAT.any.moveUp}" in="true">
      <add parentKey="PortMapping." output="instance" />
      <finish message="New port mapping for DM2 added. Instance number ${#instance}" />
    </find>
  </if>
</config>
