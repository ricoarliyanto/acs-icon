<config>
  <store value="0" target="hostsCounter" />
  
  <!-- Method 0: ZTE F670L Specific (Total Hosts: Wifi + Ethernet) -->
  <if expr="${device.productClass == 'F670L'}">
    <!-- Try DevicesCount first as it reflects total connected devices (Value: 4) -->
    <store target="devicesCount" value="${dm.getByPath('root.X_AVS_EXT.LAN.DevicesCount').value}" />
    <if expr="${#devicesCount != null and #devicesCount != '' and #devicesCount.toInt > 0}">
      <store value="${#devicesCount}" target="hostsCounter" />
    </if>
    
    <!-- Manual counting fallback (All Active Hosts) -->
    <if expr="${#hostsCounter.toInt == 0}">
      <foreach query="${root.X_AVS_EXT.LAN.Devices.any}">
        <store target="Active" value="${dm.getByPath(#i+'Active').value}" />
        <if expr="${#Active.toBoolean}">
          <store value="${#hostsCounter.toInt + 1}" target="hostsCounter" />
        </if>
      </foreach>
    </if>
    
    <!-- Final Fallback for standard LANDevice Hosts -->
    <if expr="${#hostsCounter.toInt == 0}">
      <foreach query="${root.LANDevice.`1`.Hosts.Host.any}">
        <store target="Active" value="${dm.getByPath(#i+'Active').value}" />
        <if expr="${#Active.toBoolean}">
          <store value="${#hostsCounter.toInt + 1}" target="hostsCounter" />
        </if>
      </foreach>
    </if>
  </if>

  <!-- Method 0.1: Raisecom Specific -->
  <if expr="${device.manufacturer.toLowerCaseEnglish.contains('raisecom')}">
    <!-- Try mapped root path -->
    <store target="devicesCount" value="${dm.getByPath('root.X_AVS_EXT.LAN.DevicesCount').value}" />
    
    <!-- If null, try absolute path -->
    <if expr="${#devicesCount == null}">
      <store target="devicesCount" value="${dm.getByPath('InternetGatewayDevice.X_AVS_EXT.LAN.DevicesCount').value}" />
    </if>

    <if expr="${#devicesCount != null and #devicesCount != ''}">
       <!-- Sanity Check: Ensure count is realistic (<= 1000) -->
       <if expr="${#devicesCount.toInt &lt;= 1000}">
          <store value="${#devicesCount}" target="hostsCounter" />
       </if>
    </if>
    
    <!-- Force exit/skip other methods for Raisecom to avoid bad TotalAssociations -->
    <if expr="${#hostsCounter.toInt == 0}">
       <!-- Fallback: Count Host entries directly if DevicesCount failed -->
       <foreach query="${root.LANDevice.`1`.Hosts.Host.any}">
          <store target="Active" value="${dm.getByPath(#i+'Active').value}" />
           <if expr="${#Active.toBoolean}">
             <store value="${#hostsCounter.toInt + 1}" target="hostsCounter" />
           </if>
       </foreach>
    </if>
  </if>
  
  <!-- Skip other methods if Raisecom (implicit else logic via hostCounter check, but TotalAssociations needs explicit check to be safe) -->

  <!-- Method 1: Try DevicesCount (Fiberhome specific, skip if ZTE) -->
  <if expr="${#hostsCounter.toInt == 0 and !device.manufacturer.toLowerCaseEnglish.contains('zte')}">
    <store target="devicesCount" value="${dm.getByPath('root.X_AVS_EXT.LAN.DevicesCount').value}" />
    <if expr="${#devicesCount != null and #devicesCount != ''}">
      <store value="${#devicesCount}" target="hostsCounter" />
    </if>
  </if>
  
  <!-- Method 3: Priority Manual Counting (All brands - X_AVS_EXT.LAN.Devices) -->
  <if expr="${#hostsCounter.toInt == 0}">
    <foreach query="${root.X_AVS_EXT.LAN.Devices.any}">
      <store target="InterfaceType" value="${dm.getByPath(#i+'InterfaceType').value}" />
      <store target="Active" value="${dm.getByPath(#i+'Active').value}" />
      <if expr="${#InterfaceType == '802.11' and #Active.toBoolean}">
        <store value="${#hostsCounter.toInt + 1}" target="hostsCounter" />
      </if>
    </foreach>
  </if>
  
  <!-- Method 2: Fallback to TotalAssociations (Huawei, and some others) -->
  <if expr="${#hostsCounter.toInt == 0}">
    <foreach query="${root.X_AVS_EXT.WiFi.any}">
      <store target="totalAssoc" value="${dm.getByPath(#i+'TotalAssociations').value}" />
      <if expr="${#totalAssoc != null and #totalAssoc != '' and #totalAssoc.toInt > 0 and #totalAssoc.toInt &lt; 100}">
        <store value="${#hostsCounter.toInt + #totalAssoc.toInt}" target="hostsCounter" />
      </if>
    </foreach>
  </if>
  

  
  <!-- Method 4: Alternative fallback - LANDevice.1.Hosts.Host (for devices without X_AVS_EXT) -->
  <if expr="${#hostsCounter.toInt == 0}">
    <foreach query="${root.LANDevice.`1`.Hosts.Host.any}">
      <store target="InterfaceType" value="${dm.getByPath(#i+'InterfaceType').value}" />
      <store target="Active" value="${dm.getByPath(#i+'Active').value}" />
      <if expr="${#InterfaceType == '802.11' and #Active.toBoolean}">
        <store value="${#hostsCounter.toInt + 1}" target="hostsCounter" />
      </if>
    </foreach>
  </if>
  
  <!-- Sanity Check: If hostsCounter > 1000 or has too many digits, overwrite with TotalAssociations -->
  <if expr="${#hostsCounter.toInt > 1000 or (#hostsCounter != null and #hostsCounter.length > 4)}">
     <store value="0" target="hostsCounter" />
     <foreach query="${root.X_AVS_EXT.WiFi.any}">
       <store target="assocVal" value="${dm.getByPath(#i+'TotalAssociations').value}" />
       <if expr="${#assocVal != null and #assocVal != '' and #assocVal.toInt &lt; 100}">
         <store value="${#hostsCounter.toInt + #assocVal.toInt}" target="hostsCounter" />
       </if>
     </foreach>
  </if>

  <store value="${#hostsCounter}" target="hostsCounter" type="devProp" />
</config>
