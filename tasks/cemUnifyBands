val radioList: Seq[String] = task.parameters.radioList.getOpt.flatMap(_.replace(" ", "").splitBy(",")).getOr(Seq.empty[String])
val ssid = task.parameters.selectDynamic("ssid").getOpt.filter(_.nonEmpty).getOr(fail("No SSID provided"))
val password = task.parameters.selectDynamic("password").getOpt.filter(_.nonEmpty).getOr(fail("No password provided"))

val messages = radioList.foldLeft(Seq.empty[String]){ (acc, radio) => 
  val message = try {
    if(ssid.nonEmpty && password.nonEmpty) {
      ldm.set(dmkey.root.X_AVS_EXT.WiFi(radio.toInt).SSID, ssid)
      ldm.set(dmkey.root.X_AVS_EXT.WiFi(radio.toInt).Password, password)
      "SSID set to: $ssid, Password set to $password on radio $radio"
    } else "Missing parameters: SSID: $ssid, Password: $password"  
  } catch { e =>
    log.error("Workflow has encountered an error $e")
    workflow.setStatus(status = "Error", description = "Workflow has encountered an error: $e")
    workflow.exportVariable(name = "shouldApplyRecommendation", value = false) //sanity check to not follow up on things
    fail("Workflow has encountered an error: $e")
  }
  acc+message
}

workflow.setStatus("Success", "${messages.join(" ")}") 