<config>
  <store target="interfaceId" value="${task.property.id}" />
  <store target="interfaceName" value="${task.property.Name}" />
  <store target="cliCommand" value="/interface set ${#interfaceId} name=${#interfaceName}" />
  <cli protocol="${sv.protocol}">
    <command cmd="${#cliCommand}" />
    <out target="output" />
  </cli>
  <if expr="${#output.contains('no such item')}">
    <finish status="ERROR" message="Error while executing the task ${#output}" />
  </if>
  <getParameters key="Device.X_AVS_EXT.Interface" />
</config>
