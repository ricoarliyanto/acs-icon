<config>
  <set key="Root.X_AVS_EXT.WiFi.${#radio}.Standard" value="${#standard}" />
  <log message="Standard changed to ${#standard} on radio ${#radio} by Heal Action" />
  <store target="smartWifiDisableReason" value="Manual change of standard" />
  <task template="smartWifiDisable">
    <input var="smartWifiDisableReason" />
  </task>
</config>
