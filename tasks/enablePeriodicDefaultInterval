<config>
  <in key="Root.X_AVS_EXT.Management.Periodic">
    <set key="Enable" value="true" />
  </in>
  <if expr="${sv.get('quickFix.defaultInterval') == '' ? true}">
    <workflowStatus value="Warning" desc="workflows.onlineStepTemplate.enablePeriodicDefaultInterval.status.1.description" />
    <else>
      <task template="DefaultInterval" class="com.avsystem.ump.acs.task.xml.XmlTask" />
      <workflowStatus value="Success" desc="workflows.onlineStepTemplate.enablePeriodicDefaultInterval.status.2.descriptionworkflowTranslatable${sv.get('quickFix.defaultInterval')}workflowTranslatable" />
      <requestConnection date="${date.now}" />
    </else>
  </if>
</config>
